@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.analysis
+
+import android.os.SystemClock
+import androidx.fragment.app.FragmentActivity
+import androidx.lifecycle.lifecycleScope
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.ichi2.anki.CollectionManager.withCol
+import com.ichi2.anki.libanki.sched.StudyAnalysis
+import java.lang.ref.WeakReference
+import kotlin.coroutines.resume
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.launch
+
+object StudySessionClock {
+    private val confirmation = kotlinx.coroutines.sync.Mutex()
+    private var activity = WeakReference<FragmentActivity>(null)
+    private var card = 0L
+    private var touched = SystemClock.elapsedRealtime()
+    private var pausedAt = 0L
+    private var asking = false
+
+    fun attach(value: FragmentActivity) {
+        activity = WeakReference(value)
+        if (pausedAt != 0L) { touched += SystemClock.elapsedRealtime() - pausedAt; pausedAt = 0 }
+    }
+    fun pause(value: FragmentActivity) {
+        if (activity.get() === value && pausedAt == 0L) pausedAt = SystemClock.elapsedRealtime()
+    }
+    fun touch(id: Long) {
+        if (card != id) StudyAnalysis.interruptedCard = 0
+        card = id; touched = SystemClock.elapsedRealtime(); pausedAt = 0
+    }
+
+    fun deferIfNeeded(current: FragmentActivity, id: Long, action: () -> Unit): Boolean {
+        if (asking) return true
+        if (card != id || SystemClock.elapsedRealtime() - touched < 120_000) { touch(id); return false }
+        asking = true
+        current.lifecycleScope.launch {
+            try { confirm(id); touch(id); asking = false; action() } finally { asking = false }
+        }
+        return true
+    }
+
+    suspend fun confirm(id: Long) {
+        confirmation.lock()
+        try { confirmOnce(id) } finally { confirmation.unlock() }
+    }
+
+    private suspend fun confirmOnce(id: Long) {
+        if (card != id || SystemClock.elapsedRealtime() - touched < 120_000) return
+        if (withCol { StudyAnalysis.enabledAt(this) == 0L }) return
+        withContext(Dispatchers.Main) {
+            val current = activity.get() ?: return@withContext
+            if (current.isFinishing || current.isDestroyed) return@withContext
+            suspendCancellableCoroutine<Unit> { continuation ->
+                val dialog = MaterialAlertDialogBuilder(current).setTitle("刚才被事情打断了吗？")
+                    .setMessage("这张卡片停留较久。若被打断，本次评分和 Again 次数照常保留，用时会从筛选后的统计中排除。")
+                    .setPositiveButton("被打断了") { _, _ ->
+                        StudyAnalysis.interruptedCard = id
+                        if (continuation.isActive) continuation.resume(Unit)
+                    }.setNegativeButton("一直在思考") { _, _ -> if (continuation.isActive) continuation.resume(Unit) }
+                    .setCancelable(false).show()
+                continuation.invokeOnCancellation { current.runOnUiThread { dialog.dismiss() } }
+            }
+            touched = SystemClock.elapsedRealtime()
+        }
+    }
+}
