new file mode 100644
--- /dev/null
+++ b/deploy/updates/publish_release.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Validate staged public release files and publish latest.json last, under a lock."""
+import datetime
+import fcntl
+import hashlib
+import json
+import os
+import pathlib
+import re
+import sys
+
+root = pathlib.Path("/var/www/anki-updates").resolve()
+staging = pathlib.Path(sys.argv[1]).resolve()
+if staging.parent != root / "staging" or not staging.is_dir():
+    raise SystemExit("Invalid release staging directory")
+lock_path = pathlib.Path("/opt/anki-updates/publish.lock")
+with lock_path.open("w") as lock:
+    fcntl.flock(lock, fcntl.LOCK_EX)
+    release = json.loads((staging / "latest.json").read_text("utf-8"))
+    if release["schema"] != 1 or release["packageName"] != "com.ichi2.anki.diversion":
+        raise SystemExit("Invalid application release")
+    latest = root / "latest.json"
+    previous = json.loads(latest.read_text("utf-8")) if latest.exists() else None
+    if previous and int(release["versionCode"]) <= int(previous["versionCode"]):
+        raise SystemExit("Version must increase; live feed was not changed")
+    files = list(release["artifacts"].values()) + [release["source"]]
+    for item in files:
+        name = item["file"]
+        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,150}\.(apk|zip)", name) or ".." in name:
+            raise SystemExit("Invalid artifact filename")
+        file = staging / name
+        if not file.is_file() or file.stat().st_size != item["bytes"]:
+            raise SystemExit("Release artifact size mismatch")
+        digest = hashlib.sha256()
+        with file.open("rb") as stream:
+            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(chunk)
+        if digest.hexdigest() != item["sha256"]:
+            raise SystemExit("Release artifact checksum mismatch")
+        if (root / name).exists():
+            raise SystemExit("An immutable release filename is already published")
+    for item in files:
+        destination = root / item["file"]
+        os.replace(staging / item["file"], destination)
+        destination.chmod(0o644)
+    if (staging / "index.html").is_file():
+        os.replace(staging / "index.html", root / "index.html")
+        (root / "index.html").chmod(0o644)
+    if previous:
+        history = pathlib.Path("/var/backups/anki-updates")
+        history.mkdir(parents=True, exist_ok=True)
+        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+        (history / ("latest-" + stamp + ".json")).write_text(json.dumps(previous, ensure_ascii=False), "utf-8")
+    candidate = root / "latest.next"
+    candidate.write_text(json.dumps(release, ensure_ascii=False, indent=2) + "\n", "utf-8")
+    candidate.chmod(0o644)
+    with candidate.open("rb") as stream:
+        os.fsync(stream.fileno())
+    os.replace(candidate, latest)
+print(json.dumps({"published": release["versionName"], "versionCode": release["versionCode"]}))
