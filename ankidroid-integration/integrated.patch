+++ b/common/src/test/java/com/ichi2/anki/common/updates/UpdateReleaseTest.kt
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.common.updates
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Test
+import java.io.File
+
+class UpdateReleaseTest {
+    private val artifact = UpdateArtifact("AnkiDroid-r3-arm64.apk", "a".repeat(64), 54387526)
+    private val release = UpdateRelease(22203302, "2.22.3-routing3-test", "更新测试\n含中文、\"引号\"与反斜杠\\", mapOf("arm64-v8a" to artifact))
+
+    @Test
+    fun roundTripPreservesReleaseAndNotes() {
+        assertEquals(release, UpdateRelease.parse(release.toJson()))
+    }
+
+    @Test
+    fun selectsFirstSupportedArchitecture() {
+        val arm32 = artifact.copy(file = "AnkiDroid-r3-arm32.apk")
+        val both = release.copy(artifacts = mapOf("arm64-v8a" to artifact, "armeabi-v7a" to arm32))
+        assertEquals(artifact, both.artifactFor(listOf("arm64-v8a", "armeabi-v7a")))
+        assertEquals(arm32, both.artifactFor(listOf("armeabi-v7a")))
+        assertThrows(IllegalArgumentException::class.java) { both.artifactFor(listOf("x86")) }
+    }
+
+    @Test
+    fun rejectsDifferentPackageAndSchema() {
+        assertThrows(IllegalArgumentException::class.java) { UpdateRelease.parse(release.toJson().replace(UpdateRelease.PACKAGE_NAME, "another.application")) }
+        assertThrows(IllegalArgumentException::class.java) { UpdateRelease.parse(release.toJson().replace("\"schema\":1", "\"schema\":2")) }
+    }
+
+    @Test
+    fun rejectsRemoteUrlsTraversalAndExtraQuery() {
+        listOf("../other.apk", "https://evil.example/other.apk", "/other.apk", "a..apk", "x.apk?download=true").forEach { bad ->
+            assertThrows(IllegalArgumentException::class.java) { UpdateRelease.parse(release.copy(artifacts = mapOf("arm64-v8a" to artifact.copy(file = bad))).toJson()) }
+        }
+    }
+
+    @Test
+    fun rejectsInvalidHashAndSize() {
+        listOf(artifact.copy(sha256 = "not-a-hash"), artifact.copy(bytes = 0), artifact.copy(bytes = UpdateRelease.MAX_APK_BYTES + 1)).forEach { bad ->
+            assertThrows(IllegalArgumentException::class.java) { UpdateRelease.parse(release.copy(artifacts = mapOf("arm64-v8a" to bad)).toJson()) }
+        }
+    }
+
+    @Test
+    fun rejectsLargeResponseBeforeParsing() {
+        assertThrows(IllegalArgumentException::class.java) { UpdateRelease.parse(" ".repeat(UpdateRelease.MAX_MANIFEST_BYTES + 1)) }
+    }
+
+    @Test
+    fun verifiesFileBytesWithSha256() {
+        val file = File.createTempFile("update-integrity", ".apk")
+        try {
+            file.writeText("abc")
+            assertEquals("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", UpdateRelease.sha256(file))
+        } finally { file.delete() }
+    }
+
+    private fun identity(pkg: String = UpdateRelease.PACKAGE_NAME, version: Long = 3, installed: Long = 2, actual: Set<String> = setOf("same")) =
+        UpdateRelease.requireIdentity(pkg, version, 3, installed, setOf("same"), actual)
+
+    @Test
+    fun matchingUpgradeIsAccepted() { identity() }
+
+    @Test
+    fun wrongPackageOrVersionIsRejected() {
+        assertThrows(IllegalArgumentException::class.java) { identity(pkg = "another.application") }
+        assertThrows(IllegalArgumentException::class.java) { identity(version = 4) }
+    }
+
+    @Test
+    fun downgradeAndSameVersionAreRejected() {
+        assertThrows(IllegalArgumentException::class.java) { identity(installed = 3) }
+        assertThrows(IllegalArgumentException::class.java) { identity(installed = 4) }
+    }
+
+    @Test
+    fun differentOrMissingSignerIsRejected() {
+        assertThrows(IllegalArgumentException::class.java) { identity(actual = setOf("different")) }
+        assertThrows(IllegalArgumentException::class.java) { identity(actual = emptySet()) }
+    }
+
+    @Test
+    fun allConfiguredOriginsUseHttps() {
+        UpdateRelease.TRUSTED_ORIGINS.forEach {
+            val uri = java.net.URI(it)
+            assertEquals("https", uri.scheme)
+            assertEquals("/anki-updates/", uri.path)
+            assertEquals(null, uri.userInfo)
+        }
+    }
+}
