@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.updates
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.content.pm.ServiceInfo
+import android.os.Build
+import androidx.core.app.NotificationManagerCompat
+import androidx.work.CoroutineWorker
+import androidx.work.ForegroundInfo
+import androidx.work.WorkerParameters
+import com.ichi2.anki.BuildConfig
+import com.ichi2.anki.utils.ext.trySetForeground
+import com.ichi2.utils.Permissions
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import java.io.IOException
+import timber.log.Timber
+
+class AppUpdateWorker(context: Context, parameters: WorkerParameters) : CoroutineWorker(context, parameters) {
+    companion object { private val downloadLock = Mutex() }
+
+    @SuppressLint("MissingPermission")
+    override suspend fun doWork(): Result = downloadLock.withLock {
+        val context = applicationContext
+        val manual = inputData.getBoolean("manual", false)
+        if (!manual && !AppUpdater.prefs(context).getBoolean("automatic", true)) return@withLock Result.success()
+        try {
+            val release = withContext(Dispatchers.IO) { AppUpdater.fetchRelease(context) }
+            AppUpdater.prefs(context).edit().putLong("last_check", System.currentTimeMillis()).apply()
+            if (release.versionCode <= BuildConfig.VERSION_CODE) return@withLock Result.success()
+            trySetForeground(getForegroundInfo())
+            AppUpdater.download(context, release) { percent ->
+                if (Permissions.canPostNotifications(context)) {
+                    val notification = AppUpdater.notification(context, "正在下载应用更新", "${release.versionName} · $percent%")
+                        .setOngoing(true).setProgress(100, percent, false).build()
+                    NotificationManagerCompat.from(context).notify(AppUpdater.PROGRESS_ID, notification)
+                }
+            }
+            AppUpdater.notifyReady(context, release)
+            Result.success()
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (error: Exception) {
+            Timber.w(error, "App update download failed")
+            if (manual && Permissions.canPostNotifications(context)) {
+                val message = if (error is IOException) "请检查网络后在“应用更新”中重试" else "安装包未通过检查，已停止更新"
+                NotificationManagerCompat.from(context).notify(AppUpdater.READY_ID,
+                    AppUpdater.notification(context, "更新暂未完成", message).setAutoCancel(true).build())
+            }
+            if (error is IOException && runAttemptCount < 3) Result.retry() else Result.failure()
+        } finally {
+            NotificationManagerCompat.from(context).cancel(AppUpdater.PROGRESS_ID)
+        }
+    }
+
+    override suspend fun getForegroundInfo(): ForegroundInfo {
+        val notification = AppUpdater.notification(applicationContext, "正在准备应用更新", "更新将保留现有学习数据")
+            .setOngoing(true).setProgress(0, 0, true).build()
+        return if (Build.VERSION.SDK_INT >= 29) ForegroundInfo(AppUpdater.PROGRESS_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC)
+        else ForegroundInfo(AppUpdater.PROGRESS_ID, notification)
+    }
+}
diff --git a/AnkiDroid/src/main/java/com/ichi2/anki/updates/AppUpdater.kt b/AnkiDroid/src/main/java/com/ichi2/anki/updates/AppUpdater.kt
