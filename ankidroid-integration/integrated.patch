+param(
+    [Parameter(Mandatory)][ValidateRange(2, 9999)][int]$BuildNumber,
+    [Parameter(Mandatory)][ValidateLength(1, 2000)][string]$Notes,
+    [string]$Server = '47.109.157.25',
+    [int]$Port = 2222,
+    [string]$SshKey = (Join-Path $env:USERPROFILE '.ssh\kailang_agent'),
+    [string]$SdkRoot = 'D:\android-sdk',
+    [string]$JavaRoot = 'D:\jdk17',
+    [switch]$AllowDependencyDownload
+)
+$ErrorActionPreference = 'Stop'
+$repoRoot = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..\..'))
+$workspaceRoot = Split-Path $repoRoot -Parent
+$releaseDirectory = Join-Path $workspaceRoot "outputs\AnkiDroid自动更新\routing$BuildNumber"
+$signingKey = Join-Path $workspaceRoot '.android\debug.keystore'
+if (!(Test-Path -LiteralPath $signingKey)) { throw '原签名文件缺失；不可生成新密钥替代，请先恢复原文件。' }
+if (!(Test-Path -LiteralPath $SshKey)) { throw 'ECS SSH 密钥不存在。' }
+$env:JAVA_HOME = $JavaRoot
+$env:ANDROID_HOME = $SdkRoot
+$env:ANDROID_USER_HOME = Join-Path $workspaceRoot '.android'
+$env:GRADLE_USER_HOME = Join-Path $workspaceRoot '.gradle-cache'
+$env:ANKI_UPDATE_KEYSTORE = $signingKey
+$env:Path = "$JavaRoot\bin;$env:Path"
+$expectedSigner = '7b4f72e72c4e4017341abe6760f8d94f12cca7a9c5805ebabd5fd5dd68088d33'
+$versionCode = 22203299 + $BuildNumber
+$versionName = "2.22.3-routing$BuildNumber-test"
+$sshArgs = @('-i', $SshKey, '-p', "$Port", '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes', "root@$Server")
+$scpArgs = @('-i', $SshKey, '-P', "$Port", '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes')
+New-Item -ItemType Directory -Path $releaseDirectory -Force | Out-Null
+Push-Location $repoRoot
+try {
+    $gradleArgs = @(':common:testDebugUnitTest', '--tests', 'com.ichi2.anki.common.updates.UpdateReleaseTest',
+        ':libanki:testDebugUnitTest', '--tests', 'com.ichi2.anki.libanki.sched.StudyDiversionTest',
+        '--tests', 'com.ichi2.anki.libanki.sched.StudyAnalysisTest',
+        ':AnkiDroid:assembleFullDebug', "-PdiversionBuild=$BuildNumber", '-Pkotlin.compiler.execution.strategy=in-process', '--no-daemon', '--max-workers=1', '--console=plain')
+    if (!$AllowDependencyDownload) { $gradleArgs += '--offline' }
+    & .\gradlew.bat @gradleArgs
+    if ($LASTEXITCODE -ne 0) { throw '构建或测试未通过，停止发布。' }
+    $artifacts = [ordered]@{}
+    foreach ($abi in @('arm64-v8a', 'armeabi-v7a', 'x86_64', 'x86')) {
+        $apk = Join-Path $repoRoot "AnkiDroid\build\outputs\apk\full\debug\AnkiDroid-full-$abi-debug.apk"
+        $signature = (& "$SdkRoot\build-tools\35.0.0\apksigner.bat" verify --print-certs $apk) -join "`n"
+        if ($LASTEXITCODE -ne 0 -or $signature -notmatch "certificate SHA-256 digest: $expectedSigner") { throw "签名不匹配：$abi；停止发布。" }
+        $badging = (& "$SdkRoot\build-tools\35.0.0\aapt.exe" dump badging $apk) -join "`n"
+        if ($badging -notmatch "package: name='com.ichi2.anki.diversion' versionCode='$versionCode' versionName='$versionName'") { throw "应用标识或版本不一致：$abi" }
+        $filename = "AnkiDroid-routing$BuildNumber-$abi.apk"
+        $target = Join-Path $releaseDirectory $filename
+        Copy-Item -LiteralPath $apk -Destination $target
+        $artifacts[$abi] = @{file=$filename;sha256=(Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash.ToLowerInvariant();bytes=(Get-Item -LiteralPath $target).Length}
+    }
+    $sourceName = "AnkiDroid-routing$BuildNumber-source.zip"
+    $sourcePath = Join-Path $releaseDirectory $sourceName
+    & git archive --format=zip "--output=$sourcePath" HEAD
+    if ($LASTEXITCODE -ne 0) { throw '无法打包上游源码。' }
+    $changed = @(& git -c core.quotepath=false diff --name-only HEAD) + @(& git -c core.quotepath=false ls-files --others --exclude-standard)
+    Add-Type -AssemblyName System.IO.Compression.FileSystem
+    $archive = [IO.Compression.ZipFile]::Open($sourcePath, [IO.Compression.ZipArchiveMode]::Update)
+    try {
+        foreach ($relative in ($changed | Select-Object -Unique)) {
+            if ([string]::IsNullOrWhiteSpace($relative)) { continue }
+            $path = Join-Path $repoRoot $relative
+            $entry = $archive.GetEntry($relative)
+            if ($entry) { $entry.Delete() }
+            if (Test-Path -LiteralPath $path -PathType Leaf) { [IO.Compression.ZipFileExtensions]::CreateEntryFromFile($archive, $path, $relative) | Out-Null }
+        }
+    } finally { $archive.Dispose() }
+    $release = [ordered]@{
+        schema=1;packageName='com.ichi2.anki.diversion';versionCode=$versionCode;versionName=$versionName;notes=$Notes;
+        artifacts=$artifacts;
+        source=@{file=$sourceName;sha256=(Get-FileHash -LiteralPath $sourcePath -Algorithm SHA256).Hash.ToLowerInvariant();bytes=(Get-Item -LiteralPath $sourcePath).Length}
+    }
+    $release | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $releaseDirectory 'latest.json') -Encoding utf8NoBOM
+    Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'index.html') -Destination $releaseDirectory
+    $stage = "/var/www/anki-updates/staging/routing$BuildNumber-$([guid]::NewGuid().ToString('N'))"
+    & ssh.exe @sshArgs "install -d -m 700 '$stage'"
+    if ($LASTEXITCODE -ne 0) { throw '无法创建服务器发布暂存目录。' }
+    Push-Location $releaseDirectory
+    try {
+        $upload = @($artifacts.Values | ForEach-Object { './' + $_.file }) + @("./$sourceName", './latest.json', './index.html')
+        & scp.exe @scpArgs @upload "root@${Server}:$stage/"
+        if ($LASTEXITCODE -ne 0) { throw '文件上传未完成；线上版本未切换。' }
+    } finally { Pop-Location }
+    & ssh.exe @sshArgs "python3 /opt/anki-updates/publish_release.py '$stage'"
+    if ($LASTEXITCODE -ne 0) { throw '服务端验证未通过，停止发布。' }
+    Write-Output "已发布 ${versionName}：https://kailang.online/anki-updates/"
+} finally { Pop-Location }
