@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.libanki.sched
+
+import anki.collection.OpChanges
+import anki.scheduler.CardAnswer
+import com.ichi2.anki.libanki.Collection
+import java.io.File
+import java.io.FileOutputStream
+import java.util.TimeZone
+import org.json.JSONArray
+import org.json.JSONObject
+import timber.log.Timber
+
+/** Optional analysis sidecar. Official answers/undo remain authoritative. */
+object StudyAnalysis {
+    const val ENABLED = "privateAnalysisEnabledAt"
+    const val JOURNAL = "study-analysis-events.jsonl"
+    const val SETTINGS = "study-analysis-settings.json"
+    @Volatile var interruptedCard: Long = 0
+    @Volatile var recordingError = false
+
+    fun wordText(value: String): String {
+        val plain = value.replace(Regex("(?is)<(script|style)\\b[^>]*>.*?</\\1>"), "")
+            .replace(Regex("(?s)<!--.*?-->|<[^>]*>|\\[sound:[^]]*]"), "")
+        val names = mapOf("amp" to "&", "lt" to "<", "gt" to ">", "quot" to "\"", "apos" to "'", "nbsp" to " ",
+            "rsquo" to "’", "lsquo" to "‘", "ndash" to "–", "mdash" to "—")
+        return Regex("&(#x[0-9a-fA-F]+|#[0-9]+|[a-zA-Z]+);").replace(plain) { match ->
+            val key = match.groupValues[1]
+            names[key] ?: runCatching {
+                val number = if (key.startsWith("#x")) key.drop(2).toInt(16) else key.drop(1).toInt()
+                String(Character.toChars(number))
+            }.getOrElse { match.value }
+        }.trim().take(512)
+    }
+
+    fun journal(col: Collection) = File(col.colDb.parentFile, JOURNAL)
+
+    fun enabledAt(col: Collection): Long = runCatching {
+        val file = File(col.colDb.parentFile, SETTINGS)
+        if (file.isFile) JSONObject(file.readText()).getLong("enabledAt") else 0L
+    }.getOrDefault(0L).takeIf { it > 0 } ?: (col.config.get<Long>(ENABLED) ?: 0L)
+
+    fun enable(col: Collection) {
+        if (enabledAt(col) > 0L) return
+        val file = File(col.colDb.parentFile, SETTINGS)
+        val temporary = File(file.path + ".tmp")
+        FileOutputStream(temporary).use { out ->
+            out.write(JSONObject().put("enabledAt", System.currentTimeMillis()).toString().toByteArray(Charsets.UTF_8))
+            out.fd.sync()
+        }
+        require(temporary.renameTo(file)) { "无法保存分析设置" }
+    }
+
+    fun answer(col: Collection, input: CardAnswer, eventsFile: File? = null): OpChanges {
+        val enabledAt = enabledAt(col)
+        if (enabledAt == 0L) return StudyDiversion.answer(col, input)
+        val before = col.backend.getCard(input.cardId)
+        val previous = StudyDiversion.progress(before.customData)
+        val oldReview = col.db.queryLongScalar("select max(id) from revlog where cid=?", input.cardId)
+        val changes = StudyDiversion.answer(col, input)
+        // Sidecar failure must never make a successfully saved answer appear to fail.
+        try {
+            val after = col.backend.getCard(input.cardId)
+            val next = StudyDiversion.progress(after.customData)
+            col.db.query("select id,ease,time,ivl,lastIvl,type from revlog where cid=? order by id desc limit 1", input.cardId).use { row ->
+                if (row.moveToNext() && row.getLong(0) != oldReview) {
+                    val event = JSONObject()
+                        .put("reviewId", row.getLong(0)).put("cardId", input.cardId)
+                        .put("rating", row.getInt(1)).put("timeMs", row.getLong(2))
+                        .put("interval", row.getLong(3)).put("lastInterval", row.getLong(4)).put("reviewType", row.getInt(5))
+                        .put("deckId", before.originalDeckId.takeIf { it != 0L } ?: before.deckId)
+                        .put("before", if (previous?.inRepair == true) "repair" else "main")
+                        .put("after", if (next?.inRepair == true) "repair" else "main")
+                        .put("interrupted", interruptedCard == input.cardId)
+                        .put("roundAgain", when {
+                            previous?.inRepair == true -> (previous.repairAgain + if (input.rating == CardAnswer.Rating.AGAIN) 1 else 0)
+                            next?.inRepair == true -> 10
+                            else -> next?.again ?: 0
+                        })
+                    FileOutputStream(eventsFile ?: journal(col), true).use { output ->
+                        output.write((event.toString() + "\n").toByteArray(Charsets.UTF_8))
+                        output.fd.sync()
+                    }
+                }
+            }
+        } catch (error: Exception) {
+            recordingError = true
+            Timber.w(error, "Optional study analysis event could not be recorded")
+        } finally {
+            if (interruptedCard == input.cardId) interruptedCard = 0
+        }
+        return changes
+    }
+
+    /** Called only while holding CollectionManager's queue; release it before network I/O. */
+    fun snapshot(col: Collection, collectionId: String, wordFields: Map<Long, String> = emptyMap(), eventsFile: File? = null, authorizedDeckIds: Set<Long>? = null): JSONObject {
+        val settings = requireNotNull(StudyDiversion.settings(col)) { "请先启用单词分流规则" }
+        val mainName = col.decks.name(settings.source)
+        val scope = col.decks.allNamesAndIds(false).filter {
+            it.id == settings.source || it.id == settings.repair || it.name.startsWith("$mainName::")
+        }.filter { authorizedDeckIds == null || it.id in authorizedDeckIds }.toList()
+        val scopeIds = scope.map { it.id }.toSet()
+        require(settings.source in scopeIds && settings.repair in scopeIds) { "背词牌组已改变，请检查分流规则" }
+        val cards = JSONArray()
+        val notes = linkedMapOf<Long, JSONObject>()
+        val cardIds = hashSetOf<Long>()
+        var unmapped = 0
+        val fieldIndexes = mutableMapOf<Long, Int>()
+        col.db.query("""select c.id,c.nid,c.did,c.odid,c.queue,c.type,c.due,c.ivl,c.reps,c.lapses,c.factor,c.data,n.mid,n.flds
+            from cards c join notes n on n.id=c.nid order by c.id""").use { row ->
+            while (row.moveToNext()) {
+                val cid = row.getLong(0)
+                val nid = row.getLong(1)
+                val did = row.getLong(2)
+                val odid = row.getLong(3)
+                if ((odid.takeIf { it != 0L } ?: did) !in scopeIds) continue
+                val data = JSONObject(row.getString(11).ifBlank { "{}" })
+                val progress = StudyDiversion.progress(data.optString("cd", ""))
+                if ((odid.takeIf { it != 0L } ?: did) == settings.repair &&
+                    (progress == null || progress.epoch != settings.epoch || progress.home !in scopeIds)) continue
+                val mid = row.getLong(12)
+                val index = fieldIndexes.getOrPut(mid) {
+                    val names = col.notetypes.get(mid)?.fieldsNames ?: emptyList()
+                    // Unknown templates stay blank until the user previews and chooses a field.
+                    names.indexOf(wordFields[mid] ?: "Word")
+                }
+                val fields = row.getString(13).split('\u001f')
+                val word = if (index in fields.indices) wordText(fields[index]) else ""
+                if (index < 0) unmapped++
+                notes[nid] = JSONObject().put("id", nid).put("word", word)
+                val card = JSONObject().put("id", cid).put("noteId", nid).put("deckId", did).put("originalDeckId", odid)
+                    .put("queue", row.getInt(4)).put("type", row.getInt(5)).put("due", row.getLong(6))
+                    .put("interval", row.getLong(7)).put("reps", row.getInt(8)).put("lapses", row.getInt(9)).put("factor", row.getInt(10))
+                if (progress != null && progress.epoch == settings.epoch) card.put("diversion", JSONObject()
+                    .put("epoch", progress.epoch).put("again", progress.again).put("easy", progress.easy)
+                    .put("home", progress.home).put("repairAgain", progress.repairAgain))
+                cards.put(card)
+                cardIds.add(cid)
+            }
+        }
+        val events = linkedMapOf<Long, JSONObject>()
+        val journalFile = eventsFile ?: runCatching { journal(col) }.getOrNull()
+        var corruptLines = 0
+        journalFile?.takeIf { it.isFile }?.forEachLine { line ->
+            try {
+                val event = JSONObject(line)
+                events[event.getLong("reviewId")] = event
+            } catch (_: Exception) { corruptLines++ }
+        }
+        val reviews = JSONArray()
+        val liveEvents = JSONArray()
+        col.db.query("select id,cid,ease,ivl,lastIvl,time,type from revlog order by id").use { row ->
+            while (row.moveToNext()) {
+                if (row.getLong(1) !in cardIds) continue
+                val review = JSONObject().put("id", row.getLong(0)).put("cardId", row.getLong(1)).put("ease", row.getInt(2))
+                    .put("interval", row.getLong(3)).put("lastInterval", row.getLong(4)).put("timeMs", row.getLong(5)).put("type", row.getInt(6))
+                reviews.put(review)
+                events[row.getLong(0)]?.takeIf { event ->
+                    event.optLong("cardId") == row.getLong(1) && event.optInt("rating") == row.getInt(2) &&
+                        event.optLong("interval") == row.getLong(3) && event.optLong("lastInterval") == row.getLong(4) &&
+                        event.optLong("timeMs") == row.getLong(5) && event.optInt("reviewType") == row.getInt(6) &&
+                        event.optLong("deckId") in scopeIds
+                }?.let { liveEvents.put(it) }
+            }
+        }
+        val warnings = JSONArray().put("历史牌组归属按当前卡片推定；新增阶段记录从启用后开始。")
+        if (unmapped > 0) warnings.put("$unmapped 张卡片尚未选择单词字段，文字留空，作答仍参与统计。")
+        if (recordingError || corruptLines > 0) warnings.put("部分新增分析记录未能保存或读取，修复轮次和中断统计可能不完整。")
+        return JSONObject().put("schemaVersion", 2).put("collectionId", collectionId).put("source", "ankidroid-diversion")
+            .put("capturedAt", System.currentTimeMillis()).put("zoneId", TimeZone.getDefault().id)
+            .put("rolloverHour", col.getPreferences().scheduling.rollover)
+            .put("dayIndex", col.sched.today).put("nextDayAt", col.sched.dayCutoff)
+            .put("analysisEnabledAt", enabledAt(col))
+            .put("historyAvailable", true).put("historyComplete", true)
+            .put("mainDeckId", settings.source).put("repairDeckId", settings.repair)
+            .put("scopeDeckIds", JSONArray(scope.map { it.id }))
+            .put("decks", JSONArray(scope.map { JSONObject().put("id", it.id).put("name", it.name) }))
+            .put("notes", JSONArray(notes.values.toList())).put("cards", cards).put("reviews", reviews).put("events", liveEvents).put("warnings", warnings)
+    }
+}
