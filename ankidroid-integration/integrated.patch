+
+/** Uses the real Anki backend: answers, revlog, deck moves, persistence and native undo. */
+class StudyDiversionTest : InMemoryAnkiTest() {
+    private var source = 0L
+    private var cardId = 0L
+
+    @Before
+    fun createFixture() {
+        source = col.decks.id("英语::4000词")
+        col.decks.select(source)
+        cardId = addBasicNote("interference", "干扰").firstCardId()
+        col.setDeck(listOf(cardId), source)
+    }
+
+    private fun com.ichi2.anki.libanki.Note.firstCardId() = cards(col).first().id
+
+    private fun answer(ease: Ease, id: Long = cardId) {
+        val card = col.getCard(id).apply { startTimer() }
+        val states = col.backend.getSchedulingStates(id)
+        col.sched.answerCard(col.sched.buildAnswer(card, states, ease))
+    }
+
+    private fun state(id: Long = cardId) = StudyDiversion.progress(col.getCard(id).customData)!!
+
+    private fun enable() = StudyDiversion.enable(col, source)
+
+    private fun enterRepair() {
+        repeat(5) { answer(Ease.AGAIN) }
+    }
+
+    @Test
+    fun `existing history is not counted and non Again does not clear main total`() {
+        repeat(12) { answer(Ease.AGAIN) }
+        enable()
+        answer(Ease.AGAIN)
+        assertEquals(1, state().again)
+        answer(Ease.GOOD)
+        assertEquals(1, state().again)
+        assertEquals(source, col.getCard(cardId).did)
+    }
+
+    @Test
+    fun `fifth Again routes after learning answers and preserves revlog`() {
+        val settings = enable()
+        repeat(4) { answer(Ease.AGAIN) }
+        assertEquals(source, col.getCard(cardId).did)
+        answer(Ease.AGAIN)
+        assertEquals(settings.repair, col.getCard(cardId).did)
+        assertEquals(source, state().home)
+        assertEquals(0, state().again)
+        assertEquals(5, col.db.queryScalar("select count(*) from revlog where cid = ?", cardId))
+    }
+
+    @Test
+    fun `routing6 counters above new limit survive and route on next Again`() {
+        val settings = enable()
+        val card = col.backend.getCard(cardId)
+        val data = JSONObject().put(StudyDiversion.DATA_KEY,
+            org.json.JSONArray(listOf(settings.epoch, 9, 0, 0, 0, 0)))
+        col.backend.updateCards(listOf(card.toBuilder().setCustomData(data.toString()).build()), false)
+        StudyDiversion.recoverPendingMoves(col)
+        assertEquals(source, col.getCard(cardId).did)
+        answer(Ease.GOOD)
+        assertEquals(9, state().again)
+        answer(Ease.AGAIN)
+        assertEquals(settings.repair, col.getCard(cardId).did)
+        assertEquals(source, state().home)
+        col.undo()
+        assertEquals(9, state().again)
+        assertEquals(source, col.getCard(cardId).did)
+    }
+
+    @Test
+    fun `five consecutive Easy answers same day return to original child and reset next round`() {
+        val settings = enable()
+        enterRepair()
+        repeat(4) { answer(Ease.EASY) }
+        assertEquals(settings.repair, col.getCard(cardId).did)
+        answer(Ease.EASY)
+        assertEquals(source, col.getCard(cardId).did)
+        assertEquals(0, state().again)
+        assertFalse(state().inRepair)
+        enterRepair()
+        assertEquals(settings.repair, col.getCard(cardId).did)
+        assertEquals(0, state().repairAgain)
+    }
+
+    @Test
+    fun `all non Easy answers break the streak and repair Again is separate`() {
+        enable()
+        enterRepair()
+        for (rating in listOf(Ease.GOOD, Ease.HARD, Ease.AGAIN)) {
+            answer(Ease.EASY)
+            answer(Ease.EASY)
+            answer(rating)
+            assertEquals(0, state().easy)
+        }
+        assertEquals(1, state().repairAgain)
+        assertEquals(0, state().again)
+        repeat(4) { answer(Ease.EASY) }
+        assertTrue(state().inRepair)
+    }
+
+    @Test
+    fun `one undo and redo include answer counter and migration`() {
+        val settings = enable()
+        repeat(4) { answer(Ease.AGAIN) }
+        answer(Ease.AGAIN)
+        col.undo()
+        assertEquals(source, col.getCard(cardId).did)
+        assertEquals(4, state().again)
+        assertEquals(4, col.db.queryScalar("select count(*) from revlog where cid = ?", cardId))
+        col.redo()
+        assertEquals(settings.repair, col.getCard(cardId).did)
+        assertTrue(state().inRepair)
+        repeat(5) { answer(Ease.EASY) }
+        col.undo()
+        assertEquals(settings.repair, col.getCard(cardId).did)
+        assertEquals(4, state().easy)
+    }
+
+    @Test
+    fun `unrelated decks and sibling cards are untouched`() {
+        enable()
+        val other = col.decks.id("数学")
+        col.decks.select(other)
+        val otherId = addBasicNote("limit", "极限").firstCardId()
+        col.setDeck(listOf(otherId), other)
+        repeat(12) { answer(Ease.AGAIN, otherId) }
+        assertEquals(other, col.getCard(otherId).did)
+        assertNull(StudyDiversion.progress(col.getCard(otherId).customData))
+    }
+
+    @Test
+    fun `stored metadata is reloaded from backend and unrelated custom data survives`() {
+        enable()
+        val raw = col.backend.getCard(cardId)
+        col.backend.updateCards(listOf(raw.toBuilder().setCustomData("{\"x\":7}").build()), false)
+        repeat(3) { answer(Ease.AGAIN) }
+        val reloaded = Card(col, cardId)
+        assertEquals(3, StudyDiversion.progress(reloaded.customData)!!.again)
+        assertEquals(7, JSONObject(reloaded.customData).getInt("x"))
+    }
+
+    @Test
+    fun `duplicate submission does not add another answer`() {
+        enable()
+        val card = col.getCard(cardId).apply { startTimer() }
+        val input = col.sched.buildAnswer(card, col.backend.getSchedulingStates(cardId), Ease.AGAIN)
+        col.sched.answerCard(input)
+        assertThrows<IllegalArgumentException> { col.sched.answerCard(input) }
+        assertEquals(1, state().again)
+        assertEquals(1, col.db.queryScalar("select count(*) from revlog where cid = ?", cardId))
+    }
+
+    @Test
+    fun `stop and return all is reversible and does not delete history`() {
+        val settings = enable()
+        enterRepair()
+        StudyDiversion.returnAllAndDisable(col)
+        assertFalse(StudyDiversion.settings(col)!!.enabled)
+        assertEquals(source, col.getCard(cardId).did)
+        assertEquals(5, col.db.queryScalar("select count(*) from revlog where cid = ?", cardId))
+        col.undo()
+        assertTrue(StudyDiversion.settings(col)!!.enabled)
+        assertEquals(settings.repair, col.getCard(cardId).did)
+    }
+
+    @Test
+    fun `missing destination and full custom data fail before saving answer`() {
+        val settings = enable()
+        val raw = col.backend.getCard(cardId)
+        col.backend.updateCards(listOf(raw.toBuilder().setCustomData("{\"x\":\"${"a".repeat(80)}\"}").build()), false)
+        assertThrows<IllegalArgumentException> { answer(Ease.AGAIN) }
+        assertEquals(0, col.db.queryScalar("select count(*) from revlog where cid = ?", cardId))
+        col.decks.remove(listOf(settings.repair))
+        assertThrows<IllegalArgumentException> { answer(Ease.AGAIN) }
+    }
+
+    @Test
+    fun `interrupted entry and return recover without adding review history`() {
+        val settings = enable()
+        enterRepair()
+        // Simulate stopping after saving the fifth answer, before the deck change.
+        col.setDeck(listOf(cardId), source)
+        StudyDiversion.recoverPendingMoves(col)
+        assertEquals(settings.repair, col.getCard(cardId).did)
+        // Simulate stopping after saving the fifth Easy, before returning.
+        val card = col.backend.getCard(cardId)
