@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.analysis
+
+import androidx.test.platform.app.InstrumentationRegistry
+import com.ichi2.anki.CollectionManager.withCol
+import com.ichi2.anki.libanki.sched.Ease
+import com.ichi2.anki.libanki.sched.StudyDiversion
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+
+/** Explicit opt-in ECS test using the runner's separate synthetic collection. */
+class AnalysisCloudIntegrationTest {
+    @Test fun uploadAndBackup(): Unit = runBlocking {
+        val args = InstrumentationRegistry.getArguments()
+        val code = args.getString("analysisPairCode")
+        assumeTrue("Requires an explicit disposable pairing code", !code.isNullOrBlank())
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val cardId = withCol {
+            val source = StudyDiversion.settings(this)?.source ?: decks.id("AnalysisIntegrationTest")
+            decks.select(source)
+            if (StudyDiversion.settings(this) == null) StudyDiversion.enable(this, source)
+            val model = notetypes.all().first { it.fieldsNames.size == 2 }
+            val note = newNote(model)
+            note.fields[0] = "integration-word"
+            note.fields[1] = "PRIVATE definition must stay on phone"
+            addNote(note, source)
+            note.cards(this).first().id
+        }
+        AnalysisCloud.pair(context, requireNotNull(code))
+        assertFalse(AnalysisCloud.prefs(context).getString("credential", "")!!.contains(AnalysisCloud.token(context)))
+        val answerAt = System.currentTimeMillis()
+        withCol {
+            val card = getCard(cardId).apply { startTimer() }
+            sched.answerCard(sched.buildAnswer(card, backend.getSchedulingStates(cardId), Ease.AGAIN))
+        }
+        AnalysisCloud.enqueue(context)
+        var uploaded = false
+        repeat(90) {
+            if (AnalysisCloud.prefs(context).getLong("captured", 0) >= answerAt) uploaded = true
+            if (!uploaded) delay(1000)
+        }
+        assertTrue("Upload status: ${AnalysisCloud.prefs(context).getString("status", "")}", uploaded)
+        val snapshot = AnalysisCloud.snapshot(context)
+        assertFalse(snapshot.toString().contains("PRIVATE definition"))
+        assertTrue(snapshot.getJSONArray("reviews").length() > 0)
+        assertTrue(snapshot.getJSONArray("events").length() > 0)
+        val backup = AnalysisBackup.create(context)
+        assertTrue(java.io.File(backup, "complete").isFile)
+        assertTrue(backup.listFiles()!!.any { it.extension == "colpkg" })
+        AnalysisCloud.pause(context)
+        assertFalse(AnalysisCloud.prefs(context).getBoolean("enabled", true))
+    }
+
+    @Test fun deleteTestData(): Unit = runBlocking {
+        assumeTrue(InstrumentationRegistry.getArguments().getString("analysisCleanup") == "true")
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        AnalysisCloud.delete(context)
+        assertFalse(AnalysisCloud.prefs(context).contains("credential"))
+        assertFalse(AnalysisCloud.prefs(context).getBoolean("enabled", true))
+    }
+}
