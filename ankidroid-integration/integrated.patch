--- /dev/null
+++ b/AnkiDroid/src/main/java/com/ichi2/anki/analysis/AnalysisBackup.kt
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.analysis
+
+import android.content.Context
+import com.ichi2.anki.CollectionManager.withCol
+import com.ichi2.anki.reopen
+import com.ichi2.anki.libanki.sched.StudyAnalysis
+import java.io.File
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+object AnalysisBackup {
+    /** Native consistent colpkg + private sidecar/settings. No live SQLite file copy. */
+    suspend fun create(context: Context): File = withContext(Dispatchers.IO) {
+        val destination = File(context.filesDir, "analysis-upgrade-backups/${System.currentTimeMillis()}")
+        require(destination.mkdirs()) { "无法创建备份目录" }
+        withCol {
+            val created = createBackup(destination.absolutePath, force = true, waitForCompletion = true)
+            awaitBackupCompletion()
+            // The native backup may skip an unchanged collection even when forced.
+            // Use the same native export path as AnkiDroid's collection export in that case.
+            if (!created) {
+                close(forFullSync = true)
+                try {
+                    backend.exportCollectionPackage(
+                        outPath = File(destination, "collection.colpkg").absolutePath,
+                        includeMedia = false,
+                        legacy = false,
+                    )
+                } finally { reopen() }
+            }
+            require(destination.listFiles()?.any { it.extension == "colpkg" && it.length() > 0 } == true) { "没有找到完整的词库备份" }
+            StudyAnalysis.journal(this).takeIf { it.exists() }?.copyTo(File(destination, StudyAnalysis.JOURNAL))
+            File(colDb.parentFile, StudyAnalysis.SETTINGS).takeIf { it.exists() }?.copyTo(File(destination, StudyAnalysis.SETTINGS))
+        }
+        val prefs = File(context.applicationInfo.dataDir, "shared_prefs")
+        prefs.listFiles()?.filter { it.extension == "xml" }?.forEach { file ->
+            val target = File(destination, "settings/${file.name}")
+            require(target.parentFile!!.mkdirs() || target.parentFile!!.isDirectory)
+            file.copyTo(target)
+            // SharedPreferences.apply() may not have flushed its XML yet. Keep an API snapshot too.
+            val values = context.getSharedPreferences(file.nameWithoutExtension, Context.MODE_PRIVATE).all
+            File(destination, "settings/${file.nameWithoutExtension}.json").writeText(org.json.JSONObject(values).toString())
+        }
+        File(destination, "README.txt").writeText("词库：使用 AnkiDroid 恢复 colpkg。分析记录：同名 JSONL 位于词库目录。settings 是本机设置副本，包含私人凭据，请勿公开分享。未复制媒体。\n")
+        File(destination, "complete").writeText("backup completed\n")
+        destination
+    }
+}
diff --git a/AnkiDroid/src/main/java/com/ichi2/anki/analysis/AnalysisCloud.kt b/AnkiDroid/src/main/java/com/ichi2/anki/analysis/AnalysisCloud.kt
new file mode 100644
--- /dev/null
+++ b/AnkiDroid/src/main/java/com/ichi2/anki/analysis/AnalysisCloud.kt
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.analysis
+
+import android.content.Context
+import android.security.keystore.KeyGenParameterSpec
+import android.security.keystore.KeyProperties
+import android.util.Base64
+import androidx.work.BackoffPolicy
+import androidx.work.Constraints
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingPeriodicWorkPolicy
+import androidx.work.ExistingWorkPolicy
+import androidx.work.NetworkType
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.PeriodicWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import com.ichi2.anki.CollectionManager.withCol
+import com.ichi2.anki.libanki.sched.StudyAnalysis
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import java.security.KeyStore
+import java.security.MessageDigest
+import java.util.concurrent.TimeUnit
+import java.util.zip.GZIPOutputStream
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.SecretKey
+import javax.crypto.spec.GCMParameterSpec
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONObject
+
+object AnalysisCloud {
+    const val BASE = "https://47-109-157-25.sslip.io/anki-analysis/"
+    private val origins = listOf(BASE, "https://kailang.online/anki-analysis/")
+    const val WORK = "private-study-snapshot"
+    private const val PERIODIC = "private-study-supplementary"
+    private const val KEY = "private-study-credential-v1"
+    private val client = OkHttpClient.Builder().connectTimeout(20, TimeUnit.SECONDS)
+        .readTimeout(90, TimeUnit.SECONDS).callTimeout(120, TimeUnit.SECONDS)
+        .followRedirects(false).followSslRedirects(false).build()
+    fun prefs(context: Context) = context.getSharedPreferences("private_study", Context.MODE_PRIVATE)
+
+    private fun key(): SecretKey {
+        val store = KeyStore.getInstance("AndroidKeyStore").apply { load(null) }
+        (store.getKey(KEY, null) as? SecretKey)?.let { return it }
+        return KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore").apply {
+            init(KeyGenParameterSpec.Builder(KEY, KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT)
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM).setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE).build())
+        }.generateKey()
+    }
+
+    private fun saveToken(context: Context, token: String) {
+        val cipher = Cipher.getInstance("AES/GCM/NoPadding").apply { init(Cipher.ENCRYPT_MODE, key()) }
+        val encrypted = cipher.doFinal(token.toByteArray(Charsets.UTF_8))
+        check(prefs(context).edit().putString("credential", Base64.encodeToString(cipher.iv + encrypted, Base64.NO_WRAP)).commit())
+    }
+
+    fun token(context: Context): String {
+        val data = Base64.decode(requireNotNull(prefs(context).getString("credential", null)), Base64.NO_WRAP)
+        return Cipher.getInstance("AES/GCM/NoPadding").run {
+            init(Cipher.DECRYPT_MODE, key(), GCMParameterSpec(128, data.copyOfRange(0, 12)))
+            String(doFinal(data.copyOfRange(12, data.size)), Charsets.UTF_8)
+        }
+    }
+
+    fun fields(context: Context): Map<Long, String> {
+        val json = JSONObject(prefs(context).getString("word_fields", "{}")!!)
+        return json.keys().asSequence().associate { it.toLong() to json.getString(it) }
+    }
+
+    suspend fun snapshot(context: Context): JSONObject {
+        val fields = fields(context)
+        val prefs = prefs(context)
+        val authorized = if (prefs.contains("credential")) prefs.getStringSet("authorized_decks", null)?.map { it.toLong() }?.toSet() else null
+        return withCol {
+            val settings = requireNotNull(com.ichi2.anki.libanki.sched.StudyDiversion.settings(this)) { "请先启用单词分流规则" }
+            val identity = collectionIdentity(db.queryLongScalar("select crt from col"), settings.epoch, settings.source)
+            StudyAnalysis.snapshot(this, identity, fields, authorizedDeckIds = authorized)
+        }
+    }
+
+    private fun collectionIdentity(created: Long, epoch: Long, source: Long): String = MessageDigest.getInstance("SHA-256")
+        .digest("$created/$epoch/$source".toByteArray(Charsets.UTF_8)).joinToString("") { "%02x".format(it) }
+
+    private fun request(path: String, method: String, body: ByteArray? = null, token: String? = null, gzip: Boolean = false): Pair<Int, JSONObject> {
+        var failure: IOException? = null
+        for (origin in origins) {
+            try {
+                val request = Request.Builder().url(origin + path)
+                    .apply { if (token != null) header("Authorization", "Bearer $token") }
+                    .apply { if (gzip) header("Content-Encoding", "gzip") }
+                    .method(method, body?.toRequestBody("application/json".toMediaType())).build()
+                client.newCall(request).execute().use { response ->
+                    if (response.code >= 500) throw IOException("分析服务暂不可用（${response.code}）")
+                    val text = response.body.string()
+                    require(text.length <= 64 * 1024) { "服务返回内容异常" }
+                    val json = runCatching { JSONObject(text) }.getOrElse { JSONObject().put("error", "分析服务暂不可用（${response.code}）") }
+                    return response.code to json
+                }
+            } catch (error: IOException) { failure = error }
+        }
+        throw IOException("私人云端暂时无法连接，请稍后重试", failure)
+    }
+
+    suspend fun pair(context: Context, code: String) = withContext(Dispatchers.IO) {
+        val preview = snapshot(context)
+        val (status, json) = request("v1/pair", "POST", JSONObject().put("code", code.trim()).toString().toByteArray(Charsets.UTF_8))
+        require(status == 200) { json.optString("error", "授权失败") }
+        saveToken(context, json.getString("uploadToken"))
+        val identity = withCol {
+            StudyAnalysis.enable(this)
+            val settings = requireNotNull(com.ichi2.anki.libanki.sched.StudyDiversion.settings(this))
+            collectionIdentity(db.queryLongScalar("select crt from col"), settings.epoch, settings.source)
+        }
+        check(prefs(context).edit().putString("device", json.getString("deviceId"))
+            .putString("collection", identity).putLong("sequence", 0).putBoolean("enabled", true)
+            .putStringSet("authorized_decks", preview.getJSONArray("scopeDeckIds").let { ids -> (0 until ids.length()).map { ids.getLong(it).toString() }.toSet() }).commit())
+        enqueue(context)
+    }
+
+    fun enqueue(context: Context) {
+        if (!prefs(context).getBoolean("enabled", false)) return
+        prefs(context).edit().putString("status", "等待上传，允许使用手机流量或 Wi-Fi").apply()
+        val job = OneTimeWorkRequestBuilder<AnalysisUploadWorker>()
+            .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build())
+            .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, 30, TimeUnit.SECONDS).build()
+        WorkManager.getInstance(context).enqueueUniqueWork(WORK, ExistingWorkPolicy.APPEND_OR_REPLACE, job)
+        val periodic = PeriodicWorkRequestBuilder<AnalysisUploadWorker>(6, TimeUnit.HOURS)
+            .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build()).build()
+        WorkManager.getInstance(context).enqueueUniquePeriodicWork(PERIODIC, ExistingPeriodicWorkPolicy.KEEP, periodic)
+    }
+
+    fun pause(context: Context) {
+        prefs(context).edit().putBoolean("enabled", false).putString("status", "已暂停上传，云端历史保留").apply()
+        WorkManager.getInstance(context).cancelUniqueWork(WORK)
+        WorkManager.getInstance(context).cancelUniqueWork(PERIODIC)
+    }
+
+    suspend fun delete(context: Context) = withContext(Dispatchers.IO) {
+        pause(context)
+        val (status, json) = request("v1/snapshot", "DELETE", token = token(context))
+        require(status == 200) { json.optString("error", "删除失败，请重试") }
+        prefs(context).edit().remove("credential").remove("device").putString("status", "云端分析数据已删除，设备授权已撤销").commit()
+    }
+
+    suspend fun upload(context: Context): Boolean = withContext(Dispatchers.IO) {
+        val prefs = prefs(context)
+        if (!prefs.getBoolean("enabled", false)) return@withContext true
+        val token = try { token(context) } catch (_: Exception) {
+            pause(context)
+            prefs.edit().remove("credential").putString("status", "无法恢复设备凭据，请重新授权").apply()
+            return@withContext true
+        }
+        prefs.edit().putString("status", "正在准备分析数据").apply()
+        val snapshot = snapshot(context)
+        require(snapshot.getString("collectionId") == prefs.getString("collection", null)) { "当前词库与授权时不同，请重新授权" }
+        val sequence = prefs.getLong("sequence", 0) + 1
+        check(prefs.edit().putLong("sequence", sequence).commit())
+        val data = JSONObject().put("sequence", sequence).put("snapshot", snapshot).toString().toByteArray(Charsets.UTF_8)
+        require(data.size <= 32 * 1024 * 1024) { "分析历史超过首版上限，请保留数据并联系检查" }
+        val output = ByteArrayOutputStream()
+        GZIPOutputStream(output).use { it.write(data) }
+        if (!prefs.getBoolean("enabled", false)) return@withContext true
+        prefs.edit().putString("status", "正在上传，AnkiWeb 同步单独显示结果").apply()
+        val (status, json) = request("v1/snapshot", "POST", output.toByteArray(), token, gzip = true)
+        if (status == 409 && json.has("sequence")) {
+            prefs.edit().putLong("sequence", maxOf(sequence, json.getLong("sequence"))).commit()
+            return@withContext false
+        }
+        if (status == 401) {
+            pause(context)
+            prefs.edit().remove("credential").putString("status", "授权已失效，请重新授权").apply()
+            return@withContext true
+        }
+        require(status == 200 && json.getLong("sequence") == sequence) { json.optString("error", "上传未成功（$status）") }
+        prefs.edit().putLong("last_upload", System.currentTimeMillis()).putLong("captured", snapshot.getLong("capturedAt"))
+            .putString("status", "上传成功：${snapshot.getJSONArray("cards").length()} 张卡片，${snapshot.getJSONArray("reviews").length()} 条作答")
+            .putInt("bytes", output.size()).apply()
+        true
+    }
+}
+
+class AnalysisUploadWorker(context: Context, params: WorkerParameters) : CoroutineWorker(context, params) {
+    override suspend fun doWork(): Result = try {
+        // Periodic and one-shot work share the same mutex, so snapshots never race.
+        uploadLock.lock()
+        try { if (AnalysisCloud.upload(applicationContext)) Result.success() else Result.retry() }
+        finally { uploadLock.unlock() }
+    } catch (cancelled: kotlinx.coroutines.CancellationException) {
+        throw cancelled
+    } catch (error: Exception) {
+        AnalysisCloud.prefs(applicationContext).edit().putString("status", "待重试：${error.message?.take(150) ?: "网络暂不可用"}").apply()
+        Result.retry()
+    }
+    companion object { private val uploadLock = kotlinx.coroutines.sync.Mutex() }
+}
diff --git a/AnkiDroid/src/main/java/com/ichi2/anki/analysis/StudyAnalysisUi.kt b/AnkiDroid/src/main/java/com/ichi2/anki/analysis/StudyAnalysisUi.kt
new file mode 100644
--- /dev/null
+++ b/AnkiDroid/src/main/java/com/ichi2/anki/analysis/StudyAnalysisUi.kt
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.analysis
+
+import android.content.Context
+import android.widget.EditText
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import androidx.fragment.app.FragmentActivity
+import androidx.lifecycle.lifecycleScope
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.ichi2.anki.CollectionManager.withCol
+import com.ichi2.anki.libanki.sched.StudyAnalysis
+import java.text.DateFormat
+import java.util.Calendar
+import java.util.Date
+import kotlinx.coroutines.launch
+import org.json.JSONObject
+
+object StudyAnalysisUi {
+    private fun text(activity: FragmentActivity, title: String, message: String) {
+        val content = TextView(activity).apply { text = message; setPadding(32, 20, 32, 20); textSize = 16f; setTextIsSelectable(true) }
+        MaterialAlertDialogBuilder(activity).setTitle(title).setView(ScrollView(activity).apply { addView(content) })
+            .setPositiveButton("关闭", null).show()
+    }
+
+    fun show(activity: FragmentActivity) {
+        MaterialAlertDialogBuilder(activity).setTitle("学习分析")
+            .setItems(arrayOf("今日用时、负担与修复", "云端同步与授权", "选择单词字段", "创建本地备份")) { _, index ->
+                when (index) {
+                    0 -> overview(activity)
+                    1 -> cloud(activity)
+                    2 -> chooseFields(activity)
+                    3 -> activity.lifecycleScope.launch {
+                        runCatching { AnalysisBackup.create(activity) }
+                            .onSuccess { text(activity, "备份完成", "已保存词库、分流进度、分析记录和设置，不重复复制媒体。\n\n${it.absolutePath}") }
+                            .onFailure { text(activity, "备份未完成", it.message ?: "请检查存储空间后重试") }
+                    }
+                }
+            }.setNegativeButton("关闭", null).show()
+    }
+
+    private fun overview(activity: FragmentActivity) {
+        activity.lifecycleScope.launch {
+            try {
+                val s = AnalysisCloud.snapshot(activity)
+                val cutoff = s.getLong("nextDayAt") * 1000
+                val start = Calendar.getInstance().apply { timeInMillis = cutoff; add(Calendar.DATE, -1) }.timeInMillis
+                val events = s.getJSONArray("events")
+                val interrupted = (0 until events.length()).map { events.getJSONObject(it) }
+                    .filter { it.getBoolean("interrupted") }.map { it.getLong("reviewId") }.toSet()
+                val reviews = s.getJSONArray("reviews")
+                var answers = 0; var again = 0; var raw = 0L; var filtered = 0L; var excluded = 0
+                val distinct = hashSetOf<Long>()
+                for (i in 0 until reviews.length()) {
+                    val r = reviews.getJSONObject(i)
+                    if (r.getLong("id") !in start until cutoff || r.getInt("ease") !in 1..4 || r.getInt("type") !in 0..2) continue
+                    answers++; if (r.getInt("ease") == 1) again++
+                    raw += r.getLong("timeMs"); distinct.add(r.getLong("cardId"))
+                    if (r.getLong("id") in interrupted) excluded++ else filtered += r.getLong("timeMs")
+                }
+                val words = mutableMapOf<Long, String>()
+                val notes = s.getJSONArray("notes")
+                for (i in 0 until notes.length()) notes.getJSONObject(i).let { words[it.getLong("id")] = it.getString("word") }
+                val cards = s.getJSONArray("cards")
+                val repairs = mutableListOf<String>()
+                var due = 0
+                val future = IntArray(7)
+                val today = s.getInt("dayIndex")
+                for (i in 0 until cards.length()) {
+                    val c = cards.getJSONObject(i)
+                    c.optJSONObject("diversion")?.takeIf { it.getLong("home") != 0L }?.let {
+                        repairs.add("${words[c.getLong("noteId")]?.ifBlank { "未设置单词字段" }}：Easy ${it.getInt("easy")}/5，本轮 Again ${it.getInt("repairAgain")}")
+                    }
+                    if (c.optLong("originalDeckId") != 0L) continue
+                    val queue = c.getInt("queue"); val deadline = c.getLong("due")
+                    if (queue in 1..3 && deadline <= if (queue == 1) System.currentTimeMillis() / 1000 else today.toLong()) due++
+                    if (queue == 2 || queue == 3) {
+                        val offset = (deadline - today).toInt()
+                        if (offset in 1..7) future[offset - 1]++
+                    }
+                }
+                val date = DateFormat.getDateTimeInstance(DateFormat.SHORT, DateFormat.SHORT)
+                val message = buildString {
+                    append("学习日：${date.format(Date(start))} 至 ${date.format(Date(cutoff))}\n\n")
+                    append("作答 $answers 次，涉及 ${distinct.size} 张卡片\nAgain $again 次\n")
+                    append("Anki 记录用时：${"%.1f".format(raw / 60000.0)} 分钟\n")
+                    append("排除已确认中断后：${"%.1f".format(filtered / 60000.0)} 分钟\n排除中断：$excluded 次（评分和次数保留）\n\n")
+                    append("当前到期：$due 张\n未来 7 天已排程：${future.joinToString(" / ")}\n以上不包含未来新增学习和后续重排。\n\n")
+                    append("修复组：${repairs.size} 张\n${repairs.take(30).joinToString("\n")}\n\n")
+                    append("云端：${AnalysisCloud.prefs(activity).getString("status", "尚未授权上传")}\n\n")
+                    val warnings = s.getJSONArray("warnings")
+                    for (i in 0 until warnings.length()) append("${warnings.getString(i)}\n")
+                }
+                text(activity, "今日与单词修复", message)
+            } catch (error: Exception) { text(activity, "暂时无法读取", error.message ?: "请先启用单词分流规则") }
+        }
+    }
+
+    private fun cloud(activity: FragmentActivity) {
+        val prefs = AnalysisCloud.prefs(activity)
+        val enabled = prefs.getBoolean("enabled", false)
+        val last = prefs.getLong("captured", 0)
+        val timestamp = if (last == 0L) "尚未上传" else DateFormat.getDateTimeInstance().format(Date(last))
+        MaterialAlertDialogBuilder(activity).setTitle("私人云端分析")
+            .setMessage("${prefs.getString("status", "尚未授权")}\n数据截至：$timestamp\n\n允许手机流量和 Wi-Fi。原同步按钮与背词结束后都会安排上传；AnkiWeb 的同步结果单独显示。上传后不会自动调用 AI。\n\n只上传主词组与关联修复卡片的单词、牌组、作答和修复进度，默认不传释义、例句或媒体。未选择的单词字段留空。")
+            .setPositiveButton(if (enabled) "立即上传" else "授权或恢复") { _, _ ->
+                if (enabled) AnalysisCloud.enqueue(activity)
+                else if (prefs.contains("credential")) {
+                    prefs.edit().putBoolean("enabled", true).apply(); AnalysisCloud.enqueue(activity)
+                } else consent(activity)
+            }.setNeutralButton(if (enabled) "暂停上传" else "删除云端数据") { _, _ ->
+                if (enabled) AnalysisCloud.pause(activity) else confirmDelete(activity)
+            }.setNegativeButton("关闭", null).show()
+    }
+
+    private fun consent(activity: FragmentActivity) {
+        activity.lifecycleScope.launch {
+            try {
+                val s = AnalysisCloud.snapshot(activity)
+                val names = s.getJSONArray("decks")
+                val preview = s.getJSONArray("notes")
+                val sample = (0 until preview.length()).asSequence().map { preview.getJSONObject(it).getString("word") }
+                    .filter { it.isNotBlank() }.take(5).joinToString("、")
+                MaterialAlertDialogBuilder(activity).setTitle("授权上传学习分析")
+                    .setMessage("范围：${(0 until names.length()).joinToString("、") { names.getJSONObject(it).getString("name") }}\n\n单词预览：$sample\n\n上传单词、牌组、作答记录、修复进度及中断标记。释义、例句、图片、音频默认排除。未映射字段的卡片只传作答，不传正文。\n\n${s.getJSONArray("warnings").join("\n")}\n\n可随时暂停并保留云端历史；删除是独立操作。请选择正确单词字段后再授权。")
+                    .setPositiveButton("同意并输入授权码") { _, _ -> pair(activity) }
+                    .setNeutralButton("先选单词字段") { _, _ -> chooseFields(activity) }
+                    .setNegativeButton("暂不上传", null).show()
+            } catch (error: Exception) { text(activity, "无法准备授权", error.message ?: "请先启用分流规则") }
+        }
+    }
+
+    private fun pair(activity: FragmentActivity) {
+        val input = EditText(activity).apply { hint = "输入一次性授权码"; isSingleLine = true }
+        MaterialAlertDialogBuilder(activity).setTitle("连接私人云端").setView(input)
+            .setPositiveButton("连接") { _, _ -> activity.lifecycleScope.launch {
+                try { AnalysisCloud.pair(activity, input.text.toString()); Toast.makeText(activity, "授权成功，已安排上传", Toast.LENGTH_LONG).show() }
+                catch (error: Exception) { text(activity, "连接未成功", error.message ?: "请检查授权码和网络") }
+            } }.setNegativeButton("取消", null).show()
+    }
+
+    private fun confirmDelete(activity: FragmentActivity) {
+        MaterialAlertDialogBuilder(activity).setTitle("删除云端分析数据？")
+            .setMessage("删除本设备上传的分析副本并撤销上传授权。手机词库和 AnkiWeb 数据保留；以后上传需要新的授权码。")
+            .setPositiveButton("删除云端副本") { _, _ -> activity.lifecycleScope.launch {
+                try { AnalysisCloud.delete(activity); cloud(activity) }
+                catch (error: Exception) { text(activity, "删除尚未成功", error.message ?: "请重试") }
+            } }.setNegativeButton("取消", null).show()
+    }
+
+    private fun chooseFields(activity: FragmentActivity) {
+        activity.lifecycleScope.launch {
+            val models = withCol { notetypes.all().map { Triple(it.id, it.name, it.fieldsNames) } }
+            MaterialAlertDialogBuilder(activity).setTitle("选择需要设置的卡片类型")
+                .setItems(models.map { it.second }.toTypedArray()) { _, modelIndex ->
+                    val model = models[modelIndex]
+                    MaterialAlertDialogBuilder(activity).setTitle("${model.second}：单词在哪个字段？")
+                        .setItems(model.third.toTypedArray()) { _, fieldIndex ->
+                            val field = model.third[fieldIndex]
+                            activity.lifecycleScope.launch {
+                                try {
+                                    val fields = withCol { db.queryString("select flds from notes where mid=? limit 1", model.first).split('\u001f') }
+                                    val sample = fields.getOrNull(fieldIndex)?.let { StudyAnalysis.wordText(it) } ?: "无样本"
+                                    MaterialAlertDialogBuilder(activity).setTitle("核对单词字段")
+                                        .setMessage("${model.second} → $field\n\n内容预览：\n${sample.take(600)}\n\n只有这个字段用于单词文字。请确认它是单词或短语；不要选择例句、释义或媒体字段。")
+                                        .setPositiveButton("确认是单词字段") { _, _ ->
+                                            val prefs = AnalysisCloud.prefs(activity)
+                                            val mapping = JSONObject(prefs.getString("word_fields", "{}")!!).put(model.first.toString(), field)
+                                            prefs.edit().putString("word_fields", mapping.toString()).apply()
+                                            Toast.makeText(activity, "已保存，之后的上传使用这个字段", Toast.LENGTH_LONG).show()
+                                        }.setNegativeButton("取消", null).show()
+                                } catch (error: Exception) { text(activity, "无法预览", error.message ?: "此类型没有卡片") }
+                            }
+                        }.setNegativeButton("取消", null).show()
+                }.setNegativeButton("关闭", null).show()
