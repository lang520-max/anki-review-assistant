+# Static application releases; no study database or credentials are stored here.
+location = /anki-updates/latest.json {
+    alias /var/www/anki-updates/latest.json;
+    default_type application/json;
+    add_header Cache-Control "no-store" always;
+    add_header Strict-Transport-Security "max-age=31536000" always;
+}
+location ^~ /anki-updates/staging/ { deny all; }
+location ^~ /anki-updates/ {
+    alias /var/www/anki-updates/;
+    index index.html;
+    autoindex off;
+    limit_except GET HEAD { deny all; }
+    types {
+        application/json json;
+        application/vnd.android.package-archive apk;
+        application/zip zip;
+        text/html html;
+    }
+    add_header X-Content-Type-Options nosniff always;
+    add_header Strict-Transport-Security "max-age=31536000" always;
+}
