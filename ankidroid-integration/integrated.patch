+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.libanki.sched
+
+import com.ichi2.anki.libanki.testutils.InMemoryAnkiTest
+import com.ichi2.anki.libanki.undo
+import com.ichi2.anki.libanki.redo
+import java.io.File
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class StudyAnalysisTest : InMemoryAnkiTest() {
+    @get:Rule val temp = TemporaryFolder()
+    private var source = 0L
+    private var cid = 0L
+    private lateinit var journal: File
+
+    @Before fun fixture() {
+        source = col.decks.id("English")
+        col.decks.select(source)
+        cid = addBasicNote("interference", "SECRET definition [sound:private.mp3]").cards(col).first().id
+        col.setDeck(listOf(cid), source)
+        StudyDiversion.enable(col, source)
+        col.config.set(StudyAnalysis.ENABLED, 1L)
+        journal = temp.newFile()
+        StudyAnalysis.recordingError = false
+        StudyAnalysis.interruptedCard = 0
+    }
+
+    private fun answer(ease: Ease) {
+        val card = col.getCard(cid).apply { startTimer() }
+        StudyAnalysis.answer(col, col.sched.buildAnswer(card, col.backend.getSchedulingStates(cid), ease), journal)
+    }
+    private fun snapshot(mapping: Map<Long, String> = emptyMap()) = StudyAnalysis.snapshot(col, "fixture", mapping, journal)
+
+    @Test fun `unknown note fields stay blank and definitions never enter payload`() {
+        val result = snapshot()
+        assertFalse(result.toString().contains("SECRET"))
+        assertEquals("", result.getJSONArray("notes").getJSONObject(0).getString("word"))
+        val mid = col.db.queryLongScalar("select mid from notes limit 1")
+        val names = col.notetypes.get(mid)!!.fieldsNames
+        assertEquals("interference", snapshot(mapOf(mid to names[0])).getJSONArray("notes").getJSONObject(0).getString("word"))
+    }
+
+    @Test fun `unrelated decks and manually added repair cards are excluded`() {
+        val outsider = col.decks.id("Private")
+        val other = addBasicNote("SECRET unrelated", "SECRET").cards(col).first().id
+        col.setDeck(listOf(other), outsider)
+        assertEquals(1, snapshot().getJSONArray("cards").length())
+        col.setDeck(listOf(other), StudyDiversion.settings(col)!!.repair)
+        assertEquals(1, snapshot().getJSONArray("cards").length())
+    }
+
+    @Test fun `answer metadata follows native undo and redo without stale events`() {
+        answer(Ease.AGAIN)
+        assertEquals(1, snapshot().getJSONArray("events").length())
+        col.undo()
+        assertEquals(0, snapshot().getJSONArray("reviews").length())
+        assertEquals(0, snapshot().getJSONArray("events").length())
+        col.redo()
+        assertEquals(1, snapshot().getJSONArray("events").length())
+    }
+
+    @Test fun `routing round captures enter return and real Again counts`() {
+        repeat(5) { answer(Ease.AGAIN) }
+        val entered = snapshot()
+        val progress = entered.getJSONArray("cards").getJSONObject(0).getJSONObject("diversion")
+        assertEquals(source, progress.getLong("home"))
+        assertEquals("repair", entered.getJSONArray("events").getJSONObject(4).getString("after"))
+        answer(Ease.AGAIN)
+        repeat(5) { answer(Ease.EASY) }
+        val result = snapshot()
+        assertEquals(0L, result.getJSONArray("cards").getJSONObject(0).getJSONObject("diversion").getLong("home"))
+        val returned = result.getJSONArray("events").getJSONObject(10)
+        assertEquals("repair", returned.getString("before"))
+        assertEquals("main", returned.getString("after"))
+        assertEquals(1, returned.getInt("roundAgain"))
+    }
+
+    @Test fun `interruption keeps official answer and flag expires after answer`() {
+        StudyAnalysis.interruptedCard = cid
+        answer(Ease.AGAIN)
+        answer(Ease.GOOD)
+        val events = snapshot().getJSONArray("events")
+        assertTrue(events.getJSONObject(0).getBoolean("interrupted"))
+        assertFalse(events.getJSONObject(1).getBoolean("interrupted"))
+        assertEquals(2, snapshot().getJSONArray("reviews").length())
+    }
+
+    @Test fun `corrupt journal tail preserves older valid events and warns`() {
+        answer(Ease.AGAIN)
+        journal.appendText("partial{")
+        val result = snapshot()
+        assertEquals(1, result.getJSONArray("events").length())
+        assertTrue(result.getJSONArray("warnings").toString().contains("不完整"))
+    }
+
+    @Test fun `new child deck is not automatically added to frozen authorization`() {
+        val repair = StudyDiversion.settings(col)!!.repair
+        val child = col.decks.id("English::new-unapproved")
+        val other = addBasicNote("unapproved", "SECRET").cards(col).first().id
+        col.setDeck(listOf(other), child)
+        val result = StudyAnalysis.snapshot(col, "fixture", eventsFile = journal, authorizedDeckIds = setOf(source, repair))
+        assertEquals(1, result.getJSONArray("cards").length())
+        assertFalse(result.toString().contains("unapproved"))
+    }
+}
