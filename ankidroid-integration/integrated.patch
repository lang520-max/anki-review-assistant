+        col.backend.updateCards(listOf(card.toBuilder().setCustomData(data.toString()).build()), false)
+        StudyDiversion.recoverPendingMoves(col)
+        assertEquals(source, col.getCard(cardId).did)
+        assertFalse(state().inRepair)
+        assertEquals(5, col.db.queryScalar("select count(*) from revlog where cid = ?", cardId))
+    }
+
+    @Test
+    fun `stop also clears main round and undo restores it`() {
+        enable()
+        repeat(4) { answer(Ease.AGAIN) }
+        StudyDiversion.returnAllAndDisable(col)
+        assertEquals(0, state().again)
+        col.undo()
+        assertEquals(4, state().again)
+    }
+
+    @Test
+    fun `siblings do not share counters or move together`() {
+        val note = addBasicAndReversedNote("front", "back")
