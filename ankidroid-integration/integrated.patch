+++ b/common/src/main/java/com/ichi2/anki/common/updates/UpdateRelease.kt
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.common.updates
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonObject
+import java.io.File
+import java.security.MessageDigest
+
+data class UpdateArtifact(val file: String, val sha256: String, val bytes: Long)
+
+data class UpdateRelease(
+    val versionCode: Int,
+    val versionName: String,
+    val notes: String,
+    val artifacts: Map<String, UpdateArtifact>,
+) {
+    fun artifactFor(supportedAbis: List<String>): UpdateArtifact =
+        supportedAbis.firstNotNullOfOrNull { artifacts[it] }
+            ?: throw IllegalArgumentException("本版本尚未提供适合此手机的安装包")
+
+    fun toJson(): String = buildJsonObject {
+        put("schema", 1)
+        put("packageName", PACKAGE_NAME)
+        put("versionCode", versionCode)
+        put("versionName", versionName)
+        put("notes", notes)
+        putJsonObject("artifacts") {
+            artifacts.forEach { (abi, item) ->
+                putJsonObject(abi) {
+                    put("file", item.file)
+                    put("sha256", item.sha256)
+                    put("bytes", item.bytes)
+                }
+            }
+        }
+    }.toString()
+
+    companion object {
+        const val PACKAGE_NAME = "com.ichi2.anki.diversion"
+        const val BASE_URL = "https://kailang.online/anki-updates/"
+        val TRUSTED_ORIGINS = listOf(BASE_URL, "https://47-109-157-25.sslip.io/anki-updates/")
+        const val MAX_APK_BYTES = 200L * 1024 * 1024
+        const val MAX_MANIFEST_BYTES = 32 * 1024
+
+        fun parse(text: String): UpdateRelease {
+            require(text.toByteArray().size <= MAX_MANIFEST_BYTES) { "更新说明过大" }
+            val root = Json.parseToJsonElement(text).jsonObject
+            fun JsonObject.string(key: String): String = getValue(key).jsonPrimitive.content
+            require(root.string("schema") == "1") { "不支持的更新格式" }
+            require(root.string("packageName") == PACKAGE_NAME) { "更新包不属于当前应用" }
+            val version = root.string("versionCode").toInt()
+            require(version > 0)
+            val name = root.string("versionName")
+            require(name.isNotBlank() && name.length <= 80)
+            val notes = root.string("notes")
+            require(notes.length <= 2000)
+            val items = root.getValue("artifacts").jsonObject.mapValues { (_, value) ->
+                val item = value.jsonObject
+                val file = item.string("file")
+                require(file.matches(Regex("[A-Za-z0-9][A-Za-z0-9._-]{0,150}\\.apk")) && !file.contains("..")) { "更新文件路径无效" }
+                val hash = item.string("sha256").lowercase()
+                require(hash.matches(Regex("[a-f0-9]{64}"))) { "更新校验值无效" }
+                val size = item.string("bytes").toLong()
+                require(size in 1..MAX_APK_BYTES) { "更新包大小无效" }
+                UpdateArtifact(file, hash, size)
+            }
+            require(items.isNotEmpty() && items.size <= 4 && items.keys.all { it in listOf("arm64-v8a", "armeabi-v7a", "x86_64", "x86") })
+            return UpdateRelease(version, name, notes, items)
+        }
+
+        fun sha256(file: File): String {
+            val digest = MessageDigest.getInstance("SHA-256")
+            file.inputStream().use { input ->
+                val buffer = ByteArray(64 * 1024)
+                while (true) {
+                    val count = input.read(buffer)
+                    if (count < 0) break
+                    digest.update(buffer, 0, count)
+                }
+            }
+            return digest.digest().joinToString("") { "%02x".format(it) }
+        }
+
+        fun requireIdentity(
+            packageName: String,
+            versionCode: Long,
+            expectedVersion: Int,
+            installedVersion: Long,
+            installedSigners: Set<String>,
+            archiveSigners: Set<String>,
+        ) {
+            require(packageName == PACKAGE_NAME) { "安装包的应用标识不一致" }
+            require(versionCode == expectedVersion.toLong() && versionCode > installedVersion) { "安装包版本不符合更新要求" }
+            require(installedSigners.isNotEmpty() && installedSigners == archiveSigners) { "安装包签名与当前应用不一致" }
+        }
+    }
+}
