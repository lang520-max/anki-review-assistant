+++ b/AnkiDroid/src/main/java/com/ichi2/anki/updates/AppUpdater.kt
@@ -0,0 +1,271 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.updates
+
+import android.annotation.SuppressLint
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageInfo
+import android.content.pm.PackageManager
+import android.os.Build
+import android.widget.Toast
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.fragment.app.FragmentActivity
+import androidx.lifecycle.lifecycleScope
+import androidx.work.Constraints
+import androidx.work.ExistingPeriodicWorkPolicy
+import androidx.work.ExistingWorkPolicy
+import androidx.work.NetworkType
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.PeriodicWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.workDataOf
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.ichi2.anki.BuildConfig
+import com.ichi2.anki.R
+import com.ichi2.anki.common.updates.UpdateArtifact
+import com.ichi2.anki.common.updates.UpdateRelease
+import com.ichi2.utils.Permissions
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.security.MessageDigest
+import java.util.concurrent.TimeUnit
+import kotlin.coroutines.coroutineContext
+import timber.log.Timber
+
+object AppUpdater {
+    const val CHANNEL = "diversion_updates"
+    const val READY_ID = 15725301
+    const val PROGRESS_ID = 15725302
+    private const val PERIODIC = "diversion-update-daily"
+    private const val DOWNLOAD = "diversion-update-download"
+    private var checking = false
+    private val client = OkHttpClient.Builder()
+        .connectTimeout(20, TimeUnit.SECONDS)
+        .readTimeout(45, TimeUnit.SECONDS)
+        .callTimeout(9, TimeUnit.MINUTES)
+        .followRedirects(false)
+        .followSslRedirects(false)
+        .build()
+
+    fun prefs(context: Context) = context.getSharedPreferences("diversion_updates", Context.MODE_PRIVATE)
+
+    fun onResume(activity: FragmentActivity) {
+        if (BuildConfig.APPLICATION_ID != UpdateRelease.PACKAGE_NAME) return
+        schedule(activity)
+        if (!prefs(activity).getBoolean("automatic", true) || checking) return
+        val last = prefs(activity).getLong("last_check", 0)
+        if (System.currentTimeMillis() - last < TimeUnit.HOURS.toMillis(6)) return
+        check(activity, manual = false)
+    }
+
+    fun schedule(context: Context) {
+        val manager = WorkManager.getInstance(context)
+        if (!prefs(context).getBoolean("automatic", true)) {
+            manager.cancelUniqueWork(PERIODIC)
+            return
+        }
+        val job = PeriodicWorkRequestBuilder<AppUpdateWorker>(24, TimeUnit.HOURS)
+            .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.UNMETERED).build())
+            .setInitialDelay(15, TimeUnit.MINUTES)
+            .build()
+        manager.enqueueUniquePeriodicWork(PERIODIC, ExistingPeriodicWorkPolicy.KEEP, job)
+    }
+
+    fun showSettings(activity: FragmentActivity) {
+        val enabled = prefs(activity).getBoolean("automatic", true)
+        MaterialAlertDialogBuilder(activity)
+            .setTitle("应用更新")
+            .setMessage("当前版本：${BuildConfig.VERSION_NAME}\n\n自动更新：${if (enabled) "已开启" else "已关闭"}\n开启后每天检查，连接 Wi-Fi 时自动下载。下载完成后点通知，并在系统页面确认安装。\n\n更新保留词库、学习记录和分流计数；此功能只下载应用文件。")
+            .setPositiveButton("检查更新") { _, _ -> check(activity, manual = true) }
+            .setNeutralButton(if (enabled) "关闭自动下载" else "开启自动下载") { _, _ ->
+                prefs(activity).edit().putBoolean("automatic", !enabled).apply()
+                schedule(activity)
+                if (enabled) WorkManager.getInstance(activity).cancelUniqueWork(DOWNLOAD)
+                Toast.makeText(activity, if (enabled) "已关闭自动更新" else "已开启 Wi-Fi 自动下载", Toast.LENGTH_LONG).show()
+            }.setNegativeButton("关闭", null).show()
+    }
+
+    private fun check(activity: FragmentActivity, manual: Boolean) {
+        if (checking) return
+        checking = true
+        activity.lifecycleScope.launch {
+            val waiting = if (manual) MaterialAlertDialogBuilder(activity).setMessage("正在检查更新…").setCancelable(false).show() else null
+            try {
+                val release = withContext(Dispatchers.IO) { fetchRelease(activity) }
+                prefs(activity).edit().putLong("last_check", System.currentTimeMillis()).apply()
+                waiting?.dismiss()
+                if (release.versionCode <= BuildConfig.VERSION_CODE) {
+                    if (manual) Toast.makeText(activity, "当前已是最新版本", Toast.LENGTH_LONG).show()
+                } else if (manual) {
+                    val cached = file(activity, release, release.artifactFor(Build.SUPPORTED_ABIS.toList())).isFile
+                    MaterialAlertDialogBuilder(activity)
+                        .setTitle("发现新版本 ${release.versionName}")
+                        .setMessage("${release.notes}\n\n下载约 ${release.artifactFor(Build.SUPPORTED_ABIS.toList()).bytes / 1024 / 1024} MB，保留现有学习数据。点“下载更新”允许使用当前网络；安装仍需你确认。")
+                        .setPositiveButton(if (cached) "安装更新" else "下载更新") { _, _ ->
+                            if (cached) activity.startActivity(Intent(activity, UpdateInstallerActivity::class.java).putExtra("version", release.versionCode))
+                            else enqueue(activity, allowMetered = true)
+                        }
+                        .setNegativeButton("稍后", null).show()
+                } else {
+                    enqueue(activity, allowMetered = false)
+                }
+            } catch (error: kotlinx.coroutines.CancellationException) {
+                throw error
+            } catch (error: Exception) {
+                Timber.w(error, "App update check failed")
+                if (manual && !activity.isFinishing) MaterialAlertDialogBuilder(activity)
+                    .setTitle("暂时无法检查更新")
+                    .setMessage("请确认网络可用后重试，现有背词和同步功能不受影响。")
+                    .setPositiveButton("知道了", null).show()
+            } finally {
+                waiting?.dismiss()
+                checking = false
+            }
+        }
+    }
+
+    fun enqueue(context: Context, allowMetered: Boolean) {
+        val request = OneTimeWorkRequestBuilder<AppUpdateWorker>()
+            .setInputData(workDataOf("manual" to allowMetered))
+            .setConstraints(Constraints.Builder().setRequiredNetworkType(if (allowMetered) NetworkType.CONNECTED else NetworkType.UNMETERED).build())
+            .build()
+        WorkManager.getInstance(context).enqueueUniqueWork(DOWNLOAD, ExistingWorkPolicy.REPLACE, request)
+        Toast.makeText(context, if (allowMetered) "开始下载，完成后会通知你安装" else "已安排在 Wi-Fi 下下载更新", Toast.LENGTH_LONG).show()
+    }
+
+    fun fetchRelease(context: Context): UpdateRelease {
+        val preferred = prefs(context).getString("origin", UpdateRelease.BASE_URL)
+        val origins = UpdateRelease.TRUSTED_ORIGINS.sortedBy { if (it == preferred) 0 else 1 }
+        var lastError: Exception? = null
+        for (origin in origins) {
+            try {
+                val request = Request.Builder().url(origin + "latest.json").header("Cache-Control", "no-cache").build()
+                client.newBuilder().callTimeout(30, TimeUnit.SECONDS).build().newCall(request).execute().use { response ->
+                    if (response.code != 200) throw IOException("更新服务暂不可用")
+                    val bytes = ByteArrayOutputStream()
+                    response.body.byteStream().use { stream ->
+                        val buffer = ByteArray(4096)
+                        while (true) {
+                            val count = stream.read(buffer)
+                            if (count < 0) break
+                            require(bytes.size() + count <= UpdateRelease.MAX_MANIFEST_BYTES) { "更新说明过大" }
+                            bytes.write(buffer, 0, count)
+                        }
+                    }
+                    val release = UpdateRelease.parse(bytes.toString("UTF-8"))
+                    prefs(context).edit().putString("origin", origin).apply()
+                    return release
+                }
+            } catch (error: Exception) {
+                lastError = error
+            }
+        }
+        throw IOException("更新服务暂不可用", lastError)
+    }
+
+    fun file(context: Context, release: UpdateRelease, artifact: UpdateArtifact): File =
+        File(File(context.cacheDir, "updates").apply { mkdirs() }, "${release.versionCode}-${artifact.sha256.take(12)}.apk")
+
+    suspend fun download(context: Context, release: UpdateRelease, progress: (Int) -> Unit): File = withContext(Dispatchers.IO) {
+        val artifact = release.artifactFor(Build.SUPPORTED_ABIS.toList())
+        val final = file(context, release, artifact)
+        if (final.isFile) {
+            try {
+                verify(context, final, release)
+                return@withContext final
+            } catch (_: Exception) {
+                final.delete()
+            }
+        }
+        val partial = File(final.parentFile, final.name + ".part")
+        var offset = partial.length().takeIf { it in 1 until artifact.bytes } ?: 0L
+        val origin = prefs(context).getString("origin", UpdateRelease.BASE_URL).takeIf { it in UpdateRelease.TRUSTED_ORIGINS } ?: UpdateRelease.BASE_URL
+        val request = Request.Builder().url(origin + artifact.file)
+            .apply { if (offset > 0) header("Range", "bytes=$offset-") }.build()
+        client.newCall(request).execute().use { response ->
+            require(response.code == 200 || response.code == 206 && offset > 0) { "更新下载未成功" }
+            if (response.code == 206) require(response.header("Content-Range")?.startsWith("bytes $offset-") == true)
+            if (response.code == 200) offset = 0
+            response.body.byteStream().use { stream ->
+                FileOutputStream(partial, offset > 0).use { output ->
+                    val buffer = ByteArray(64 * 1024)
+                    var total = offset
+                    var shown = -1
+                    while (true) {
+                        coroutineContext.ensureActive()
+                        val count = stream.read(buffer)
+                        if (count < 0) break
+                        total += count
+                        require(total <= artifact.bytes) { "更新下载超出预期大小" }
+                        output.write(buffer, 0, count)
+                        val percent = (total * 100 / artifact.bytes).toInt()
+                        if (percent != shown) {
+                            progress(percent)
+                            shown = percent
+                        }
+                    }
+                    output.fd.sync()
+                    if (total != artifact.bytes) throw IOException("更新包尚未下载完整")
+                }
+            }
+        }
+        require(UpdateRelease.sha256(partial) == artifact.sha256) { "更新文件校验不一致" }
+        require(partial.renameTo(final)) { "无法保存更新文件" }
+        try {
+            verify(context, final, release)
+        } catch (error: Exception) {
+            final.delete()
+            throw error
+        }
+        final
+    }
+
+    @Suppress("DEPRECATION")
+    fun verify(context: Context, file: File, release: UpdateRelease) {
+        val artifact = release.artifactFor(Build.SUPPORTED_ABIS.toList())
+        require(file.length() == artifact.bytes && UpdateRelease.sha256(file) == artifact.sha256) { "更新包校验失败" }
+        val flags = if (Build.VERSION.SDK_INT >= 28) PackageManager.GET_SIGNING_CERTIFICATES else PackageManager.GET_SIGNATURES
+        val current = context.packageManager.getPackageInfo(context.packageName, flags)
+        val archive = requireNotNull(context.packageManager.getPackageArchiveInfo(file.absolutePath, flags)) { "无法读取安装包" }
+        fun version(info: PackageInfo): Long = if (Build.VERSION.SDK_INT >= 28) info.longVersionCode else info.versionCode.toLong()
+        fun signers(info: PackageInfo): Set<String> {
+            val signatures = if (Build.VERSION.SDK_INT >= 28) info.signingInfo?.apkContentsSigners else info.signatures
+            return signatures?.map { sig -> MessageDigest.getInstance("SHA-256").digest(sig.toByteArray()).joinToString("") { "%02x".format(it) } }?.toSet() ?: emptySet()
+        }
+        UpdateRelease.requireIdentity(archive.packageName, version(archive), release.versionCode, version(current), signers(current), signers(archive))
+    }
+
+    fun createChannel(context: Context) {
+        if (Build.VERSION.SDK_INT >= 26) context.getSystemService(NotificationManager::class.java)
+            .createNotificationChannel(NotificationChannel(CHANNEL, "应用更新", NotificationManager.IMPORTANCE_LOW))
+    }
+
+    fun notification(context: Context, title: String, text: String): NotificationCompat.Builder {
+        createChannel(context)
+        return NotificationCompat.Builder(context, CHANNEL).setSmallIcon(R.drawable.ic_star_notify)
+            .setContentTitle(title).setContentText(text).setStyle(NotificationCompat.BigTextStyle().bigText(text)).setOnlyAlertOnce(true)
+    }
+
+    @SuppressLint("MissingPermission")
+    fun notifyReady(context: Context, release: UpdateRelease) {
+        prefs(context).edit().putString("ready", release.toJson()).apply()
+        if (!Permissions.canPostNotifications(context)) return
+        val intent = Intent(context, UpdateInstallerActivity::class.java).putExtra("version", release.versionCode)
+        val pending = PendingIntent.getActivity(context, release.versionCode, intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+        val message = notification(context, "更新已下载：${release.versionName}", "点此确认安装，词库和学习记录会保留。")
+            .setContentIntent(pending).setAutoCancel(true).build()
+        NotificationManagerCompat.from(context).notify(READY_ID, message)
+    }
+}
diff --git a/AnkiDroid/src/main/java/com/ichi2/anki/updates/UpdateInstallerActivity.kt b/AnkiDroid/src/main/java/com/ichi2/anki/updates/UpdateInstallerActivity.kt
new file mode 100644
--- /dev/null
+++ b/AnkiDroid/src/main/java/com/ichi2/anki/updates/UpdateInstallerActivity.kt
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.updates
+
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.Bundle
+import android.provider.Settings
+import android.widget.Toast
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.content.FileProvider
+import androidx.lifecycle.lifecycleScope
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.ichi2.anki.BuildConfig
+import com.ichi2.anki.common.updates.UpdateRelease
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.File
+
+/** The system installer always makes the final decision; this activity never installs silently. */
+class UpdateInstallerActivity : AppCompatActivity() {
+    private lateinit var release: UpdateRelease
+    private lateinit var apk: File
+    private var externalFlow = false
+    private val permission = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) {
+        if (Build.VERSION.SDK_INT < 26 || packageManager.canRequestPackageInstalls()) install()
+        else finish()
+    }
+    private val installer = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) { finish() }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        try {
+            release = UpdateRelease.parse(requireNotNull(AppUpdater.prefs(this).getString("ready", null)))
+            require(release.versionCode == intent.getIntExtra("version", 0) && release.versionCode > BuildConfig.VERSION_CODE)
+            apk = AppUpdater.file(this, release, release.artifactFor(Build.SUPPORTED_ABIS.toList()))
+        } catch (_: Exception) {
+            Toast.makeText(this, "请在“应用更新”中重新检查版本", Toast.LENGTH_LONG).show()
+            finish()
+            return
+        }
+        externalFlow = savedInstanceState?.getBoolean("external_flow", false) == true
+        if (externalFlow) return
+        if (Build.VERSION.SDK_INT >= 26 && !packageManager.canRequestPackageInstalls()) {
+            MaterialAlertDialogBuilder(this)
+                .setTitle("允许安装应用更新")
+                .setMessage("接下来在系统页面允许“AnkiDroid 分流测试”安装应用，再返回确认更新。词库和学习记录会保留。")
+                .setPositiveButton("前往允许") { _, _ ->
+                    externalFlow = true
+                    permission.launch(Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, Uri.parse("package:$packageName")))
+                }
+                .setNegativeButton("稍后") { _, _ -> finish() }
+                .setOnCancelListener { finish() }.show()
+        } else install()
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        outState.putBoolean("external_flow", externalFlow)
+        super.onSaveInstanceState(outState)
+    }
+
+    private fun install() {
+        lifecycleScope.launch {
+            try {
+                withContext(Dispatchers.IO) { AppUpdater.verify(this@UpdateInstallerActivity, apk, release) }
+                com.ichi2.anki.analysis.AnalysisBackup.create(this@UpdateInstallerActivity)
+                val uri = FileProvider.getUriForFile(this@UpdateInstallerActivity, "$packageName.apkgfileprovider", apk)
+                externalFlow = true
+                installer.launch(Intent(Intent.ACTION_VIEW).setDataAndType(uri, "application/vnd.android.package-archive")
+                    .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION).putExtra(Intent.EXTRA_RETURN_RESULT, true))
+            } catch (_: Exception) {
+                MaterialAlertDialogBuilder(this@UpdateInstallerActivity).setTitle("无法安装此更新")
+                    .setMessage("更新校验、本地备份或系统安装准备未完成，本次安装已停止。请检查存储空间后重试。")
+                    .setPositiveButton("关闭") { _, _ -> finish() }.setOnCancelListener { finish() }.show()
+            }
+        }
+    }
+}
