+++ b/deploy/updates/setup_server.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Install the isolated static update location after checking the audited Nginx file."""
+import argparse
+import hashlib
+import pathlib
+import shutil
+import subprocess
+import datetime
+import re
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--expected-nginx-sha256", required=True)
+parser.add_argument("--snippet", required=True)
+parser.add_argument("--publisher", required=True)
+parser.add_argument("--nginx-config", choices=["/etc/nginx/conf.d/exam-kailang.conf", "/etc/nginx/conf.d/aa-47-109-157-25.sslip.io.conf"], default="/etc/nginx/conf.d/exam-kailang.conf")
+args = parser.parse_args()
+config = pathlib.Path(args.nginx_config)
+original = config.read_bytes()
+if hashlib.sha256(original).hexdigest() != args.expected_nginx_sha256:
+    raise SystemExit("Nginx configuration changed since audit; inspect again before deploying")
+snippet = pathlib.Path("/etc/nginx/snippets/anki-updates.inc")
+old_snippet = snippet.read_bytes() if snippet.exists() else None
+backup = pathlib.Path("/var/backups/anki-updates")
+backup.mkdir(parents=True, exist_ok=True)
+stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+shutil.copy2(config, backup / (config.name + "." + stamp))
+root = pathlib.Path("/var/www/anki-updates")
+root.mkdir(mode=0o755, parents=True, exist_ok=True)
+(root / "staging").mkdir(mode=0o700, exist_ok=True)
+private = pathlib.Path("/opt/anki-updates")
+private.mkdir(mode=0o755, exist_ok=True)
+shutil.copyfile(args.publisher, private / "publish_release.py")
+(private / "publish_release.py").chmod(0o700)
+addition = b"    include /etc/nginx/snippets/anki-updates.inc;\n"
+try:
+    shutil.copyfile(args.snippet, snippet)
+    snippet.chmod(0o644)
+    if addition.strip() not in original:
+        if config.name == "exam-kailang.conf":
+            anchor = b"    include /etc/nginx/snippets/exam-locations.inc;"
+            if original.count(anchor) != 2:
+                raise RuntimeError("Unexpected HTTPS server structure")
+            new = original.replace(anchor, addition + anchor)
+        else:
+            pattern = rb"(?m)^([ \t]*listen[ \t]+443[ \t]+ssl[^;]*;)"
+            if len(re.findall(pattern, original)) != 1:
+                raise RuntimeError("Unexpected backup HTTPS server structure")
+            new = re.sub(pattern, lambda match: addition + match.group(1), original, count=1)
+        temporary = config.with_suffix(".anki-update.tmp")
+        temporary.write_bytes(new)
+        temporary.chmod(config.stat().st_mode & 0o777)
+        temporary.replace(config)
+    subprocess.run(["nginx", "-t"], check=True)
+    subprocess.run(["nginx", "-s", "reload"], check=True)
+except Exception:
+    config.write_bytes(original)
+    if old_snippet is None:
+        snippet.unlink(missing_ok=True)
+    else:
+        snippet.write_bytes(old_snippet)
+    raise
+print("HTTPS update path installed; existing website routes preserved")
