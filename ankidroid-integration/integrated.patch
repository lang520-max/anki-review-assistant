@@ -0,0 +1,254 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.ichi2.anki.libanki.sched
+
+import anki.collection.OpChanges
+import anki.scheduler.CardAnswer
+import com.google.protobuf.kotlin.toByteStringUtf8
+import com.ichi2.anki.libanki.Collection
+import com.ichi2.anki.libanki.DeckConfig
+import com.ichi2.anki.libanki.DeckId
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** Opt-in, per-card routing. Native scheduling, review history and sibling cards are preserved. */
+object StudyDiversion {
+    const val CONFIG_KEY = "studyDiversionV1"
+    const val DATA_KEY = "sdr"
+    const val AGAIN_LIMIT = 5
+    // routing6 stored main counters up to 9. Preserve them across this upgrade.
+    private const val MAX_STORED_AGAIN = 9
+    const val EASY_LIMIT = 5
+
+    @Serializable
+    data class Settings(
+        val source: Long,
+        val repair: Long,
+        val epoch: Long,
+        val enabled: Boolean = true,
+    )
+
+    data class Progress(
+        val epoch: Long,
+        val again: Int = 0,
+        val easy: Int = 0,
+        val home: Long = 0,
+        val repairAgain: Int = 0,
+        val lastAnswer: Long = 0,
+    ) {
+        val inRepair: Boolean get() = home != 0L
+
+        fun answer(rating: CardAnswer.Rating, originalDeck: Long): Progress =
+            if (inRepair) {
+                when (rating) {
+                    CardAnswer.Rating.EASY -> copy(easy = easy + 1)
+                    CardAnswer.Rating.AGAIN -> copy(easy = 0, repairAgain = repairAgain + 1)
+                    else -> copy(easy = 0)
+                }
+            } else if (rating == CardAnswer.Rating.AGAIN) {
+                if (again + 1 >= AGAIN_LIMIT) Progress(epoch, home = originalDeck) else copy(again = again + 1)
+            } else {
+                this
+            }
+    }
+
+    fun settings(col: Collection): Settings? = col.config.get(CONFIG_KEY)
+
+    fun progress(data: String): Progress? {
+        if (data.isBlank()) return null
+        val array = JSONObject(data).optJSONArray(DATA_KEY) ?: return null
+        require(array.length() == 6) { "分流计数格式异常，请暂停规则并检查卡片信息。" }
+        return Progress(array.getLong(0), array.getInt(1), array.getInt(2), array.getLong(3), array.getInt(4), array.getLong(5)).also {
+            require(it.again in 0..MAX_STORED_AGAIN && it.easy in 0..EASY_LIMIT && it.home >= 0 && it.repairAgain >= 0) {
+                "分流计数异常，请暂停规则并检查卡片信息。"
+            }
+        }
+    }
+
+    private fun encode(data: String, progress: Progress?): String {
+        val json = if (data.isBlank()) JSONObject() else JSONObject(data)
+        if (progress == null) {
+            json.remove(DATA_KEY)
+        } else {
+            json.put(DATA_KEY, JSONArray(listOf(progress.epoch, progress.again, progress.easy, progress.home, progress.repairAgain, progress.lastAnswer)))
+        }
+        val result = if (json.length() == 0) "" else json.toString()
+        require(result.toByteArray(Charsets.UTF_8).size <= 100) {
+            "这张卡的自定义数据空间不足，答题尚未保存。请暂停分流规则后继续，并保留原数据排查。"
+        }
+        return result
+    }
+
+    fun enable(col: Collection, source: DeckId): Settings {
+        val existing = settings(col)
+        if (existing != null) {
+            require(existing.source == source) { "已有另一牌组的规则，请先停用并归还卡片。" }
+            validate(col, existing)
+            return existing.copy(enabled = true).also { col.config.set(CONFIG_KEY, it) }
+        }
+        require(col.decks.have(source) && !col.decks.isFiltered(source)) { "请在原来的普通单词牌组中启用。" }
+        var name = "单词修复"
+        var suffix = 2
+        while (col.decks.idForName(name) != null) name = "单词修复（${suffix++}）"
+        val repair = col.decks.id(name)
+        // A separate preset keeps edits in the repair deck from altering the source preset.
+        val preset = DeckConfig(JSONObject(col.decks.configDictForDeckId(source).jsonObject.toString()))
+        preset.id = 0
+        preset.name = "$name · 独立设置"
+        preset.new.perDay = 0
+        preset.lapse.leechAction = 1
+        col.decks.save(preset)
+        col.decks.setConfigIdForDeckDict(col.decks.getLegacy(repair)!!, preset.id)
+        return Settings(source, repair, System.currentTimeMillis()).also { col.config.set(CONFIG_KEY, it) }
+    }
+
+    private fun validate(col: Collection, settings: Settings) {
+        require(col.decks.have(settings.source) && col.decks.have(settings.repair)) { "分流牌组已被删除，请先停用规则并恢复牌组。" }
+        require(!col.decks.isFiltered(settings.source) && !col.decks.isFiltered(settings.repair)) { "分流规则需要普通牌组。" }
+        require(!insideSource(col, settings, settings.repair)) { "请把修复组移出原组的子牌组范围，再继续复习。" }
+    }
+
+    private fun insideSource(col: Collection, settings: Settings, deckId: Long): Boolean {
+        val sourceName = col.decks.name(settings.source)
+        val name = col.decks.name(deckId)
+        return deckId == settings.source || name.startsWith("$sourceName::")
+    }
+
+    /** Every native answer path calls this exactly once; failed/duplicate answers never advance progress. */
+    fun answer(col: Collection, input: CardAnswer): OpChanges {
+        val settings = settings(col)
+        val before = col.backend.getCard(input.cardId)
+        val saved = progress(before.customData)
+        // Preview-only filtered answers are not scheduled learning events.
+        val preview = input.currentState.hasFiltered() && !input.currentState.filtered.hasRescheduling()
+        val homeDeck = before.originalDeckId.takeIf { it != 0L } ?: before.deckId
+        val active = settings?.enabled == true && !preview &&
+            (insideSource(col, settings, homeDeck) || saved?.let { it.epoch == settings.epoch && it.inRepair } == true)
+        if (!active) {
+            // Preserve our metadata if ordinary scheduling would otherwise clear customData.
+            val preserved = if (saved == null) input else input.withData(encode(mergedData(before.customData, input.newState.customData), saved))
+            return col.backend.answerCard(preserved)
+        }
+        requireNotNull(settings)
+        validate(col, settings)
+        val recorded = saved?.takeIf { it.epoch == settings.epoch } ?: Progress(settings.epoch)
+        // A crash after the deck move, before clearing the completed round, must not restart repair.
+        val previous = if (recorded.inRepair && recorded.easy >= EASY_LIMIT && homeDeck == recorded.home) {
+            Progress(settings.epoch, lastAnswer = recorded.lastAnswer)
+        } else {
+            recorded
+        }
+        require(input.answeredAtMillis != previous.lastAnswer) { "这次作答已保存，请勿重复提交。" }
+        // A manually moved, unrelated card should not silently be pulled into this rule.
+        require(homeDeck != settings.repair || previous.inRepair) { "此卡未由规则迁入，请将手动加入的卡移回原组。" }
+        val next = previous.answer(input.rating, homeDeck)
+        val destination = when {
+            !previous.inRepair && next.inRepair -> settings.repair
+            next.inRepair && next.easy >= EASY_LIMIT -> next.home
+            next.inRepair && homeDeck != settings.repair -> settings.repair // recover an interrupted move
+            else -> null
+        }
+        if (destination != null) {
+            require(col.decks.have(destination) && !col.decks.isFiltered(destination)) { "原归属牌组已不存在，请先恢复牌组后继续。" }
+        }
+        // Keep the destination until the movement is complete, so interrupted moves are recoverable.
+        val finalProgress = next.copy(lastAnswer = input.answeredAtMillis)
+        val prepared = input.withData(encode(mergedData(before.customData, input.newState.customData), finalProgress))
+        val changes = col.backend.answerCard(prepared)
+        val undoStep = col.backend.getUndoStatus().lastStep
+        try {
+            var extraChanges = false
+            val after = col.backend.getCard(input.cardId)
+            // The explicit routing rule supersedes automatic leech suspension, never manual suspension.
+            if (after.queue == -1 && before.queue >= 0 && input.rating == CardAnswer.Rating.AGAIN && col.sched.stateIsLeech(input.newState)) {
+                col.sched.unsuspendCards(listOf(input.cardId))
+                extraChanges = true
+            }
+            if (destination != null) {
+                col.setDeck(listOf(input.cardId), destination)
+                extraChanges = true
+            }
+            if (next.easy >= EASY_LIMIT) {
+                val moved = col.backend.getCard(input.cardId)
+                val reset = Progress(settings.epoch, lastAnswer = input.answeredAtMillis)
+                col.backend.updateCards(listOf(moved.toBuilder().setCustomData(encode(moved.customData, reset)).build()), false)
+                extraChanges = true
+            }
+            return if (extraChanges) col.backend.mergeUndoEntries(undoStep) else changes
+        } catch (error: Exception) {
+            // Restore the answer and any completed movement together if an additional operation fails.
+            col.backend.mergeUndoEntries(undoStep)
+            col.backend.undo()
+            throw error
+        }
+    }
+
+    private fun mergedData(previous: String, scheduled: String): String {
+        val result = if (previous.isBlank()) JSONObject() else JSONObject(previous)
+        if (scheduled.isNotBlank()) {
+            val newer = JSONObject(scheduled)
+            newer.keys().forEach { key -> if (key != DATA_KEY) result.put(key, newer.get(key)) }
+        }
+        return result.toString()
+    }
+
+    private fun CardAnswer.withData(data: String): CardAnswer =
+        toBuilder().setNewState(newState.toBuilder().setCustomData(data)).build()
+
+    private fun trackedCards(col: Collection, settings: Settings): List<Pair<Long, Progress>> =
+        col.db.queryLongList("select id from cards where data like '%sdr%'").mapNotNull { id ->
+            progress(col.backend.getCard(id).customData)?.takeIf { it.epoch == settings.epoch }?.let { id to it }
+        }
+
+    fun managedCards(col: Collection, settings: Settings): List<Pair<Long, Progress>> =
+        trackedCards(col, settings).filter { it.second.inRepair }
+
+    /** Complete deck moves interrupted by an application/process stop, without adding review events. */
+    fun recoverPendingMoves(col: Collection) {
+        val settings = settings(col)?.takeIf { it.enabled } ?: return
+        validate(col, settings)
+        managedCards(col, settings).forEach { (id, state) ->
+            val card = col.backend.getCard(id)
+            val home = card.originalDeckId.takeIf { it != 0L } ?: card.deckId
+            val expected = if (state.easy >= EASY_LIMIT) state.home else settings.repair
+            require(col.decks.have(expected) && !col.decks.isFiltered(expected)) { "有分流卡的原牌组已不存在，请先恢复。" }
+            if (home != expected || state.easy >= EASY_LIMIT) {
+                val undoStep = col.backend.addCustomUndoEntry("恢复分流卡归属")
+                if (home != expected) col.setDeck(listOf(id), expected)
+                if (state.easy >= EASY_LIMIT) {
+                    val moved = col.backend.getCard(id)
+                    val reset = Progress(settings.epoch, lastAnswer = state.lastAnswer)
+                    col.backend.updateCards(listOf(moved.toBuilder().setCustomData(encode(moved.customData, reset)).build()), false)
+                }
+                col.backend.mergeUndoEntries(undoStep)
+            }
+        }
+    }
+
+    /** Explicit rollback. One native undo restores the disabled setting, cards and counters together. */
+    fun returnAllAndDisable(col: Collection): OpChanges {
+        val settings = requireNotNull(settings(col))
+        val cards = trackedCards(col, settings)
+        cards.filter { it.second.inRepair }.forEach { (_, state) -> require(col.decks.have(state.home) && !col.decks.isFiltered(state.home)) { "有卡片的原牌组已不存在，请先恢复。" } }
+        val undoStep = col.backend.addCustomUndoEntry("停用分流并归还卡片")
+        cards.forEach { (id, state) ->
+            if (state.inRepair) col.setDeck(listOf(id), state.home)
+            val card = col.backend.getCard(id)
+            col.backend.updateCards(listOf(card.toBuilder().setCustomData(encode(card.customData, Progress(settings.epoch))).build()), false)
+        }
+        col.backend.setConfigJson(CONFIG_KEY, Json.encodeToString(settings.copy(enabled = false)).toByteStringUtf8(), true)
+        return col.backend.mergeUndoEntries(undoStep)
+    }
+
+    fun feedback(col: Collection, id: Long, previouslyInRepair: Boolean): String? {
+        val state = progress(col.backend.getCard(id).customData) ?: return null
+        if (settings(col)?.enabled != true) return null
+        return when {
+            state.inRepair && !previouslyInRepair -> "累计达到 $AGAIN_LIMIT 次 Again，已移入单词修复"
+            !state.inRepair && previouslyInRepair -> "连续 5 次 Easy，已回到原牌组"
+            state.inRepair -> "修复进度：连续 Easy ${state.easy}/5 · 本轮 Again ${state.repairAgain}"
+            else -> null
+        }
+    }
+}
